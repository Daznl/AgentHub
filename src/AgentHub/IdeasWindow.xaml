<Window x:Class="AgentHub.IdeasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AgentHub - Orchestration" Height="820" Width="1240" MinHeight="600" MinWidth="960"
        Icon="Assets/AppIcon.png" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="Editor" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#0A111B" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="AcceptsTab" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style x:Key="FieldInput" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#0E1624" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Header bar with title, orchestrator status, and action buttons -->
            <RowDefinition Height="Auto" />
            <!-- Main content split: Ideas list & Idea details/handoff -->
            <RowDefinition Height="*" />
            <!-- Bottom section: Orchestrator live monitor & logs -->
            <RowDefinition Height="210" />
        </Grid.RowDefinitions>

        <!-- TOP BAR -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🧭 Orchestration" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                        <Border x:Name="OrchestratorStatusBadge" Background="#1E293B" CornerRadius="4" Padding="8,3" Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="OrchestratorStatusText" Text="IDLE" Foreground="#94A3B8" FontSize="11" FontWeight="Bold" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="OrchestratorSubtext" Text="Maintain your app ideas, orchestrate background building while away, auto-wait on Claude usage resets &amp; handoff." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0" />
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ToggleOrchestratorBtn" Click="ToggleOrchestrator_Click" Content="▶ Start Auto-Builder (Work Mode)" Background="#10B981" FontWeight="SemiBold" Padding="14,8" Margin="0,0,8,0" ToolTip="Runs through queued ideas, monitors Claude usage caps, and handles context handoffs automatically" />
                    <Button Click="SyncGitHub_Click" Content="🔄 Sync with GitHub" Background="#2563EB" FontWeight="SemiBold" Padding="12,8" Margin="0,0,8,0" ToolTip="Pull latest AgentHub from GitHub and build" />
                    <Button Click="AddIdea_Click" Content="➕ Add Idea" Background="#7C3AED" FontWeight="SemiBold" Padding="12,8" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN SPLIT -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <!-- Ideas List -->
                <ColumnDefinition Width="460" MinWidth="340" />
                <ColumnDefinition Width="12" />
                <!-- Idea Detail & Handoff Inspector -->
                <ColumnDefinition Width="*" MinWidth="400" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: IDEAS QUEUE -->
            <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="4,2,4,8">
                        <TextBlock Text="Build Queue" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                        <TextBlock x:Name="QueueCountText" Text="0 ideas" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </DockPanel>

                    <ListBox x:Name="IdeasList" SelectionChanged="IdeasList_SelectionChanged" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Title & Status -->
                                        <DockPanel Grid.Row="0">
                                            <Border DockPanel.Dock="Right" Background="{Binding StatusBadgeBrush}" CornerRadius="3" Padding="6,2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding StatusBadgeText}" Foreground="White" FontSize="10" FontWeight="Bold" />
                                            </Border>
                                            <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </DockPanel>

                                        <!-- Target Folder & Handoffs -->
                                        <StackPanel Grid.Row="1" Margin="0,5,0,6">
                                            <TextBlock Text="{Binding TargetDirectory}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding AgentCommand, StringFormat='CLI: {0}'}" Foreground="#60A5FA" FontSize="11" Margin="0,0,10,0" />
                                                <TextBlock Text="{Binding HandoffCount, StringFormat='Handoffs: {0}'}" Foreground="#34D399" FontSize="11" Margin="0,0,10,0" />
                                                <TextBlock Text="{Binding ContextHandoffThreshold, StringFormat='Trigger: {0:P0}'}" Foreground="#FBBF24" FontSize="11" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Card Action Buttons -->
                                        <DockPanel Grid.Row="2">
                                            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                                <Button Content="▲" Click="MoveUp_Click" Tag="{Binding}" Width="26" Height="24" Padding="0" Margin="0,0,4,0" ToolTip="Move up in priority" />
                                                <Button Content="▼" Click="MoveDown_Click" Tag="{Binding}" Width="26" Height="24" Padding="0" Margin="0,0,8,0" ToolTip="Move down in priority" />
                                            </StackPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="▶ Build Now" Click="BuildNow_Click" Tag="{Binding}" Background="#047857" FontSize="11" Padding="8,3" Margin="0,0,6,0" ToolTip="Start building this idea in the Cockpit right away" />
                                                <Button Content="✕" Click="DeleteIdea_Click" Tag="{Binding}" Background="#7F1D1D" FontSize="11" Width="26" Height="24" Padding="0" ToolTip="Delete this idea" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- SPLITTER -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" />

            <!-- RIGHT: IDEA EDITOR & HANDOFF PREVIEW -->
            <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,12,4,12">
                <!-- Scrolls when the window is too short for the editor; the handoff box keeps a usable height instead of being cut off. -->
                <ScrollViewer x:Name="EditorScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="EditorGrid" Margin="0,0,8,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="110" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="180" />
                    </Grid.RowDefinitions>

                    <!-- Idea Title & Target Directory -->
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="130" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="App / Idea Title" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3" />
                            <TextBox x:Name="EditTitleBox" Style="{StaticResource FieldInput}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,10,0">
                            <TextBlock Text="Agent CLI" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3" />
                            <ComboBox x:Name="EditAgentCombo" Height="30" Background="#0E1624" Foreground="{StaticResource TextBrush}">
                                <ComboBoxItem Content="claude" IsSelected="True" />
                                <ComboBoxItem Content="codex" />
                                <ComboBoxItem Content="agy" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Context Handoff" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3" />
                            <TextBox x:Name="EditThresholdBox" Style="{StaticResource FieldInput}" Text="75%" ToolTip="Context window fraction where handoff occurs" />
                        </StackPanel>
                    </Grid>

                    <!-- Repository and workflow -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,10">
                        <TextBlock Text="Repository (where the code is built: one of AgentHub's repositories)" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,3" />
                        <DockPanel>
                            <Button x:Name="NewProjectBtn" DockPanel.Dock="Right" Content="➕ New project" Click="NewProjectRepo_Click" Padding="10,5" Margin="6,0,0,0" Height="30"
                                    ToolTip="Create a new folder under Desktop\ClaudeCProjects (named after the idea), git init it and add it to AgentHub's repositories" />
                            <Button x:Name="AddFolderBtn" DockPanel.Dock="Right" Content="Add folder…" Click="BrowseTargetDir_Click" Padding="10,5" Margin="6,0,0,0" Height="30"
                                    ToolTip="Pick a folder on disk; it is added to AgentHub's repositories (git init if it has no Git yet)" />
                            <ComboBox x:Name="EditRepoCombo" Height="30" Margin="0" Background="#0E1624" Foreground="{StaticResource TextBrush}" MaxDropDownHeight="420"
                                      IsTextSearchEnabled="True" TextSearch.TextPath="Name" ToolTip="AgentHub's repositories (the list on the main window)">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding LocalPath}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="10,1,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </DockPanel>
                        <DockPanel x:Name="RepoWarningPanel" Visibility="Collapsed" Margin="0,4,0,0">
                            <Button x:Name="AddUnlistedBtn" DockPanel.Dock="Right" Content="➕ Add to AgentHub" Click="AddCurrentFolderAsRepo_Click" Padding="8,2" FontSize="11" />
                            <TextBlock x:Name="RepoWarningText" Foreground="#FBBF24" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>

                        <TextBlock Text="Orchestrator workflow" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,10,0,3" />
                        <DockPanel>
                            <Button x:Name="WorkflowsBtn" DockPanel.Dock="Right" Content="Workflows…" Click="ManageWorkflows_Click" Padding="10,5" Margin="6,0,0,0" Height="30"
                                    ToolTip="Workflow catalogue: duplicate a template, fill in its inputs, save it, pick it" />
                            <ComboBox x:Name="EditWorkflowCombo" Height="30" Margin="0" Background="#0E1624" Foreground="{StaticResource TextBrush}" DisplayMemberPath="DisplayName"
                                      ToolTip="How the orchestrator runs this idea (Builder, Data Processing, Demo Builder or one of your own)" />
                        </DockPanel>
                    </StackPanel>

                    <!-- Description / Specifications -->
                    <DockPanel Grid.Row="2" Margin="0,0,0,10">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <TextBlock Text="Requirements, Features &amp; Specifications" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" />
                            <Button DockPanel.Dock="Right" Content="💾 Save Changes" Click="SaveIdea_Click" Background="#2563EB" FontWeight="SemiBold" FontSize="11" Padding="10,3" HorizontalAlignment="Right" />
                        </DockPanel>
                        <TextBox x:Name="EditDescriptionBox" Style="{StaticResource Editor}" />
                    </DockPanel>

                    <!-- Message the orchestrator: steers go to the orchestrator, never straight to the worker -->
                    <Border Grid.Row="3" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <TextBlock Text="🧭 Message the orchestrator" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="A steer for the orchestrator: it decides how to pass it to the builder, by default when the builder's turn ends" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Top">
                                    <Button x:Name="QueueSteerBtn" Content="🧭 Send to orchestrator" Click="QueueSteer_Click" Background="#2563EB" FontWeight="SemiBold" FontSize="11" Padding="10,4" Margin="0,0,0,4" ToolTip="The orchestrator gets it when the builder next finishes a turn (straight away if the builder is idle). Ctrl+Enter" />
                                    <Button x:Name="SendSteerNowBtn" Content="⚡ Urgent" Click="SendSteerNow_Click" FontSize="11" Padding="10,4" ToolTip="The orchestrator gets it now and relays it to the builder straight away, even mid-turn" />
                                </StackPanel>
                                <TextBox x:Name="SteerBox" Style="{StaticResource Editor}" Height="54" FontFamily="Segoe UI" PreviewKeyDown="SteerBox_PreviewKeyDown"
                                         ToolTip="e.g. Focus on a backtest report before more training runs. This goes to the orchestrator, not the builder." />
                            </DockPanel>
                            <ItemsControl x:Name="SteerNotesList" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,2,0,0">
                                            <Button DockPanel.Dock="Right" Content="✕" Click="RemoveSteer_Click" Tag="{Binding}" FontSize="10" Width="22" Height="20" Padding="0" Margin="6,0,0,0" ToolTip="Remove this queued note">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDelivered}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding StatusText}" Width="118" FontSize="11" Foreground="#FBBF24">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDelivered}" Value="True">
                                                                <Setter Property="Foreground" Value="#34D399" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Text}" FontSize="11" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Handoff Viewer Header -->
                    <DockPanel Grid.Row="4" Margin="0,4,0,4">
                        <TextBlock Text="Latest Handoff (.agenthub/handoff.md)" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Content="Open in Context Window" Click="OpenHandoffInContext_Click" FontSize="11" Padding="8,3" HorizontalAlignment="Right" />
                    </DockPanel>

                    <!-- Handoff Viewer Content -->
                    <TextBox x:Name="HandoffPreviewBox" Grid.Row="5" Style="{StaticResource Editor}" IsReadOnly="True" />
                </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- BOTTOM PANEL: ORCHESTRATOR LIVE MONITOR & LOGS -->
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Metrics & Quota Gauges -->
                    <ColumnDefinition Width="340" />
                    <ColumnDefinition Width="12" />
                    <!-- Live Event Log -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Quotas & Status Gauges -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Live Orchestrator Status" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextBrush}" Margin="0,0,0,8" />

                    <!-- Active Idea -->
                    <TextBlock Text="Current Active Build:" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                    <TextBlock x:Name="ActiveIdeaLabel" Text="None (Idle)" FontWeight="SemiBold" FontSize="12" Foreground="#60A5FA" Margin="0,1,0,8" />

                    <!-- Claude Usage Limits -->
                    <TextBlock Text="Claude Quota Monitor:" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                    <TextBlock x:Name="ClaudeQuotaLabel" Text="Checking usage..." FontSize="11" Foreground="{StaticResource TextBrush}" Margin="0,1,0,8" />

                    <!-- Next Reset Timer -->
                    <TextBlock Text="Next Quota Reset:" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                    <TextBlock x:Name="ResetCountdownLabel" Text="None active" FontSize="11" FontWeight="SemiBold" Foreground="#F59E0B" Margin="0,1,0,8" />

                    <!-- The orchestrator's own one-line progress -->
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="📂 Runs" Click="OpenRuns_Click" FontSize="10" Padding="6,1" ToolTip="Open the recorded orchestrator runs (INDEX.md and one REVIEW.md per run)" />
                        <TextBlock Text="🧠 Orchestrator (Sonnet):" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock x:Name="OrchestratorProgressLabel" Text="Not running" FontSize="11" Foreground="#A78BFA" TextWrapping="Wrap" MaxHeight="44" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                </StackPanel>

                <!-- SPLITTER -->
                <Border Grid.Column="1" Width="1" Background="{StaticResource BorderBrush}" HorizontalAlignment="Center" />

                <!-- LIVE LOG -->
                <DockPanel Grid.Column="2">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                        <TextBlock Text="Orchestrator Activity Log" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Content="Clear Log" Click="ClearLog_Click" FontSize="10" Padding="6,2" HorizontalAlignment="Right" />
                    </DockPanel>

                    <ListBox x:Name="LogListBox" Background="#070C14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Foreground="{StaticResource TextBrush}" FontFamily="Cascadia Mono, Consolas" FontSize="11">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding FormattedTime, StringFormat='[{0}] '}" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Text="{Binding Message}" Foreground="{StaticResource TextBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
