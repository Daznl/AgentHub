<Window x:Class="AgentHub.WorkflowsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AgentHub - Orchestration Templates" Height="700" Width="1120" MinHeight="520" MinWidth="860"
        Icon="Assets/AppIcon.png" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="Editor" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#0A111B" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="AcceptsTab" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>
        <Style x:Key="FieldInput" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#0E1624" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Catalogue -->
        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Text="📚 Template catalogue" FontSize="15" FontWeight="Bold" />
                    <TextBlock Text="📋 shipped templates: edit one and Save to make your own; the template stays as it is. Each is a context the 🧭 Orchestrate menu offers." Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
                <TextBlock x:Name="StorageText" DockPanel.Dock="Bottom" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,8,0,0" />
                <ListBox x:Name="WorkflowList" SelectionChanged="WorkflowList_SelectionChanged" Background="#0A111B" BorderBrush="{StaticResource BorderBrush}" Foreground="{StaticResource TextBrush}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="2,4">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="12" />
                                <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" MaxWidth="250" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- Editor -->
        <Border Grid.Column="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button x:Name="DuplicateBtn" Content="⧉ Duplicate" Click="Duplicate_Click" Padding="10,4" Margin="0,0,6,0" ToolTip="Copy this workflow to make one of your own (for a template: the way to change it)" />
                        <Button x:Name="NewBtn" Content="➕ New" Click="New_Click" Padding="10,4" Margin="0,0,6,0" ToolTip="A blank workflow" />
                        <Button x:Name="DeleteBtn" Content="🗑 Delete" Click="Delete_Click" Padding="10,4" Margin="0,0,6,0" />
                        <Button x:Name="SaveBtn" Content="💾 Save" Click="Save_Click" Background="#2563EB" FontWeight="SemiBold" Padding="12,4" ToolTip="Saved in workflows/local of the AgentHub folder: stays on this computer, never committed" />
                    </StackPanel>
                    <TextBlock x:Name="ModeText" VerticalAlignment="Center" FontSize="12" Foreground="#FBBF24" TextWrapping="Wrap" />
                </DockPanel>

                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="90" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Name" Style="{StaticResource Label}" />
                        <TextBox x:Name="NameBox" Style="{StaticResource FieldInput}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Orchestrator model" Style="{StaticResource Label}" />
                        <ComboBox x:Name="ModelCombo" Height="28" Margin="0" Background="#0E1624" Foreground="{StaticResource TextBrush}" ToolTip="The Claude model the orchestrator runs on">
                            <ComboBoxItem Content="sonnet" />
                            <ComboBoxItem Content="opus" />
                            <ComboBoxItem Content="haiku" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Handoff at %" Style="{StaticResource Label}" />
                        <TextBox x:Name="ThresholdBox" Style="{StaticResource FieldInput}" ToolTip="Context window % at which the session hands off to a fresh one (40–95). Blank: the Handoff at field in the orchestrator box decides, starting from its last value." />
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Description" Style="{StaticResource Label}" />
                        <TextBox x:Name="DescriptionBox" Style="{StaticResource FieldInput}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Use when" Style="{StaticResource Label}" />
                        <TextBox x:Name="UseWhenBox" Style="{StaticResource FieldInput}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="3" Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource Label}" TextWrapping="Wrap"
                               Text="Inputs: the details this workflow needs from you, such as where your pipeline is. Replace each &lt;…&gt; placeholder after the colon with your own value (e.g. pipeline_location: C:\work\pipeline.xlsx). Wherever the instructions say {{pipeline_location}}, your value is filled in. Builder needs none." />
                    <TextBox x:Name="InputsBox" Style="{StaticResource Editor}" Height="58" />
                </StackPanel>

                <DockPanel Grid.Row="4" Margin="0,0,0,8">
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Label}" TextWrapping="Wrap"
                                   Text="Orchestrator instructions: what the orchestrator (the headless Claude session put on a pane with 🧭 Orchestrate) should make the session do, check, and count as done. Your messages in its box add to these. AgentHub adds the reply format itself." />
                    <TextBox x:Name="InstructionsBox" Style="{StaticResource Editor}" />
                </DockPanel>

                <DockPanel Grid.Row="5">
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" />
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
