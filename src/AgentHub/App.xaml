<Application x:Class="AgentHub.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AgentHub.Controls"
             xmlns:orch="clr-namespace:AgentHub.Services.Orchestrator"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Futuristic AI palette, tuned to the AgentHub logo:
             deep blue-black surfaces, electric-cyan primary accent (robot),
             with mint (OpenAI) and orange (crab) available as neon highlights. -->
        <!-- Panels and cards are slightly translucent so the animated backdrop glows through them. -->
        <SolidColorBrush x:Key="PanelBrush" Color="#E00C121C" />
        <SolidColorBrush x:Key="CardBrush" Color="#E6121A27" />
        <SolidColorBrush x:Key="BorderBrush" Color="#1E2C40" />
        <SolidColorBrush x:Key="TextBrush" Color="#E8F1FB" />
        <SolidColorBrush x:Key="MutedBrush" Color="#7E8CA6" />
        <SolidColorBrush x:Key="AccentBrush" Color="#2FD4F5" />
        <SolidColorBrush x:Key="AccentGreenBrush" Color="#34E5A8" />
        <SolidColorBrush x:Key="AccentOrangeBrush" Color="#FF7A45" />

        <!-- Subtle diagonal deep-space gradient for the main window backdrop. -->
        <LinearGradientBrush x:Key="WindowBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0B1420" Offset="0" />
            <GradientStop Color="#080C15" Offset="0.55" />
            <GradientStop Color="#05080E" Offset="1" />
        </LinearGradientBrush>

        <!-- Thin, dark, rounded scrollbar. The default Windows scrollbar is thick, light, and
             visually collides with list content (e.g. the repo status badges). -->
        <Style x:Key="ThinScrollThumb" TargetType="Thumb">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bar" CornerRadius="4" Background="#24344B" Margin="2" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bar" Property="Background" Value="#35506F" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollTrackButton" TargetType="RepeatButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollTrackButton}" Command="ScrollBar.PageUpCommand" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ThinScrollThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource ScrollTrackButton}" Command="ScrollBar.PageDownCommand" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="12" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollTrackButton}" Command="ScrollBar.PageLeftCommand" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ThinScrollThumb}" />
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource ScrollTrackButton}" Command="ScrollBar.PageRightCommand" />
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource WindowBackgroundBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>
        <!-- A bare TextBlock defaults to BLACK foreground and does not inherit Window.Foreground,
             so headings/values without an explicit Foreground were invisible on the dark theme.
             Any TextBlock that sets its own Foreground still overrides this default. -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#141D2B" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <!-- Translucent overlay gives every button (whatever its base colour) a consistent hover/press highlight -->
                                <Border x:Name="Overlay" CornerRadius="6" Background="#FFFFFF" Opacity="0" />
                                <!-- Button's default HorizontalContentAlignment is Center; menus (SSH, resume) set Left/Stretch -->
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Overlay" Property="Opacity" Value="0.10" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Overlay" Property="Opacity" Value="0.18" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#0E1622" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark ComboBox: default WPF chrome renders black-on-light, unreadable on this theme -->
        <ControlTemplate x:Key="ComboToggleChrome" TargetType="ToggleButton">
            <Border x:Name="Chrome" CornerRadius="6" Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="22" />
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Data="M 0 0 L 4 4 L 8 0 Z" Fill="{StaticResource MutedBrush}" />
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Template="{StaticResource ComboToggleChrome}"
                                          Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                            <!-- Clipped so long selections stop before the 22px arrow column instead of running under it -->
                            <Border IsHitTestVisible="False" ClipToBounds="True" Margin="0,0,26,0">
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                  Margin="{TemplateBinding Padding}"
                                                  TextElement.Foreground="{StaticResource TextBrush}"
                                                  VerticalAlignment="Center" HorizontalAlignment="Left" />
                            </Border>
                            <Popup Placement="Bottom" Focusable="False" AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Slide">
                                <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="6" Margin="0,2,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer>
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" CornerRadius="4" Margin="3,1"
                                Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1B2838" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#1B2838" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The helpers' orange crab (Context window and main window), drawn as vectors: WPF renders emoji in one flat colour only -->
        <SolidColorBrush x:Key="CrabBrush" Color="#FF7A45" />
        <DrawingImage x:Key="CrabIcon">
            <DrawingImage.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="Transparent" Geometry="M 0,0 H 24 V 24 H 0 Z" />
                    <!-- Legs, arms and eye stalks -->
                    <GeometryDrawing Geometry="M 7,15 L 3.4,16.4 M 7.6,16.7 L 4.6,19.4 M 9.2,17.7 L 7.4,20.6 M 17,15 L 20.6,16.4 M 16.4,16.7 L 19.4,19.4 M 14.8,17.7 L 16.6,20.6 M 4.4,9 L 7,12.4 M 19.6,9 L 17,12.4 M 10,10.6 L 9.4,7.6 M 14,10.6 L 14.6,7.6">
                        <GeometryDrawing.Pen>
                            <Pen Brush="{StaticResource CrabBrush}" Thickness="1.5" StartLineCap="Round" EndLineCap="Round" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <!-- Body, open pincers, eyes -->
                    <GeometryDrawing Brush="{StaticResource CrabBrush}">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup FillRule="Nonzero">
                                <EllipseGeometry Center="12,14" RadiusX="6.4" RadiusY="4.4" />
                                <PathGeometry Figures="M 2.4,9.6 C 0.2,7.8 0.8,3.8 3.8,3.4 L 3.9,6.3 L 6.4,4.9 C 7,7.7 5.3,10.1 2.4,9.6 Z" />
                                <PathGeometry Figures="M 21.6,9.6 C 23.8,7.8 23.2,3.8 20.2,3.4 L 20.1,6.3 L 17.6,4.9 C 17,7.7 18.7,10.1 21.6,9.6 Z" />
                                <EllipseGeometry Center="9.3,7.1" RadiusX="1.5" RadiusY="1.5" />
                                <EllipseGeometry Center="14.7,7.1" RadiusX="1.5" RadiusY="1.5" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <!-- Pupils and a smile -->
                    <GeometryDrawing Brush="#1A0E08">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <EllipseGeometry Center="9.5,7" RadiusX="0.65" RadiusY="0.65" />
                                <EllipseGeometry Center="14.5,7" RadiusX="0.65" RadiusY="0.65" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Geometry="M 10.2,14.6 Q 12,16 13.8,14.6">
                        <GeometryDrawing.Pen>
                            <Pen Brush="#1A0E08" Thickness="0.9" StartLineCap="Round" EndLineCap="Round" />
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage.Drawing>
        </DrawingImage>

        <!-- Round crab button that opens and closes the helper; lit while the helper is open -->
        <Style x:Key="CrabToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Disc" CornerRadius="19" Background="#24160F" BorderBrush="#5A3320" BorderThickness="1">
                            <Image Source="{StaticResource CrabIcon}" Width="26" Height="26" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Disc" Property="Background" Value="#3D2214" />
                                <Setter TargetName="Disc" Property="BorderBrush" Value="{StaticResource CrabBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Disc" Property="BorderBrush" Value="{StaticResource CrabBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Disc" Property="BorderBrush" Value="{StaticResource CrabBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Example requests shown in an empty helper, and follow-up suggestions; a click uses the text -->
        <Style x:Key="ExampleChip" TargetType="Button">
            <Setter Property="Foreground" Value="#C9D4E5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chip" CornerRadius="8" Background="#121B28" BorderBrush="#1E2C40" BorderThickness="1" Padding="10,6">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" TextWrapping="Wrap" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource CrabBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One line of a helper conversation (HelperMessage): the user's words on the right, the crab's reply on the left -->
        <DataTemplate x:Key="HelperMessageTemplate">
            <DockPanel Margin="{Binding Indent}" HorizontalAlignment="{Binding Alignment}">
                <Image DockPanel.Dock="Left" Source="{StaticResource CrabIcon}" Width="20" Height="20" Margin="0,2,8,0" VerticalAlignment="Top"
                       Visibility="{Binding CrabVisibility}" />
                <Border Background="{Binding Background}" BorderBrush="{Binding Border}" BorderThickness="1" CornerRadius="8" Padding="10,7">
                    <TextBlock controls:RichText.Markup="{Binding Text}" Foreground="{Binding Foreground}" FontSize="12" TextWrapping="Wrap" />
                </Border>
            </DockPanel>
        </DataTemplate>

        <!-- One message in the orchestrator box's conversation: who to whom and when, then the whole text. -->
        <DataTemplate x:Key="OrchestratorExchangeTemplate" DataType="{x:Type orch:OrchestratorExchange}">
            <Border x:Name="Card" BorderThickness="2,0,0,0" BorderBrush="#9AA8BE" Padding="8,3,4,4" Margin="0,0,0,4" Background="#1B1633">
                <StackPanel>
                    <TextBlock x:Name="Head" FontSize="10" FontWeight="Bold" Foreground="#9AA8BE">
                        <Run Text="{Binding At, StringFormat='{}{0:HH:mm}', Mode=OneTime}" />
                        <Run Text=" · " />
                        <Run Text="{Binding Label, Mode=OneTime}" />
                    </TextBlock>
                    <TextBlock x:Name="Body" Text="{Binding Text, Mode=OneTime}" Foreground="#C9D3E3" FontSize="11" TextWrapping="Wrap" Margin="0,1,0,0" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static orch:ExchangeKind.Read}">
                    <Setter TargetName="Card" Property="BorderBrush" Value="#38BDF8" />
                    <Setter TargetName="Head" Property="Foreground" Value="#7DD3FC" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static orch:ExchangeKind.Sent}">
                    <Setter TargetName="Card" Property="BorderBrush" Value="#A78BFA" />
                    <Setter TargetName="Head" Property="Foreground" Value="#C4B5FD" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static orch:ExchangeKind.Wait}">
                    <Setter TargetName="Card" Property="BorderBrush" Value="#5A6B85" />
                    <Setter TargetName="Head" Property="Foreground" Value="#7E8CA6" />
                    <Setter TargetName="Body" Property="Foreground" Value="#7E8CA6" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static orch:ExchangeKind.Steer}">
                    <Setter TargetName="Card" Property="BorderBrush" Value="#FBBF24" />
                    <Setter TargetName="Head" Property="Foreground" Value="#FCD34D" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static orch:ExchangeKind.Question}">
                    <Setter TargetName="Card" Property="BorderBrush" Value="#F87171" />
                    <Setter TargetName="Head" Property="Foreground" Value="#FCA5A5" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static orch:ExchangeKind.AgentHub}">
                    <Setter TargetName="Card" Property="BorderBrush" Value="#4ADE80" />
                    <Setter TargetName="Head" Property="Foreground" Value="#86EFAC" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static orch:ExchangeKind.Note}">
                    <Setter TargetName="Card" Property="BorderBrush" Value="#4ADE80" />
                    <Setter TargetName="Head" Property="Foreground" Value="#86EFAC" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static orch:ExchangeKind.Reply}">
                    <Setter TargetName="Card" Property="BorderBrush" Value="#2DD4BF" />
                    <Setter TargetName="Card" Property="Background" Value="#14262B" />
                    <Setter TargetName="Head" Property="Foreground" Value="#5EEAD4" />
                    <Setter TargetName="Body" Property="Foreground" Value="#E2E8F0" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Application.Resources>
</Application>
