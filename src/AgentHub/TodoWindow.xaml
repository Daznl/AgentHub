<Window x:Class="AgentHub.TodoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AgentHub - To do" Height="640" Width="640" MinHeight="360" MinWidth="460"
        Icon="Assets/AppIcon.png" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI">
    <Window.Resources>
        <!-- Task box in the app's dark style (WPF's default is a bright white square) -->
        <Style TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" Background="#0A111B" BorderBrush="#3A4B66" BorderThickness="1" VerticalAlignment="Center">
                            <Path x:Name="Tick" Data="M 4,9 L 7.5,12.5 L 14,5" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Visibility="Collapsed" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#0E7490" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#0E7490" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="ApplicationCommands.Save" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Save" Executed="SaveCommand_Executed" />
    </Window.CommandBindings>

    <Grid Margin="16,14,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="HeadingText" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="SubheadingText" Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <DockPanel Grid.Row="1" Margin="2,0,0,8" LastChildFill="True">
            <Border x:Name="FileStateBadge" DockPanel.Dock="Left" CornerRadius="4" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center">
                <TextBlock x:Name="FileStateText" FontSize="10" FontWeight="Bold" />
            </Border>
            <TextBlock x:Name="FilePathText" Foreground="{StaticResource MutedBrush}" FontSize="11" FontFamily="Cascadia Mono, Consolas"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <Border Grid.Row="2" Background="#0A111B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="TaskList" Margin="8" />
                </ScrollViewer>
                <TextBlock x:Name="EmptyHint" IsHitTestVisible="False" Margin="18,14,18,0" Foreground="#4A5A73" FontSize="13" TextWrapping="Wrap"
                           VerticalAlignment="Top" Text="No tasks yet. Type one below and press Enter." />
            </Grid>
        </Border>

        <!-- New task: Enter adds it at the end -->
        <DockPanel Grid.Row="3" Margin="0,10,0,0" LastChildFill="True">
            <Button x:Name="AddBtn" DockPanel.Dock="Right" Click="Add_Click" Content="Add" Margin="8,0,0,0" Padding="16,6" FontSize="12" FontWeight="SemiBold"
                    ToolTip="Add this task at the end of the list" />
            <TextBox x:Name="NewTaskBox" KeyDown="NewTaskBox_KeyDown" AutomationProperties.Name="New task" MinHeight="30" FontSize="13" />
        </DockPanel>

        <DockPanel Grid.Row="4" Margin="0,12,0,0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="OpenFolderBtn" Click="OpenFolder_Click" Content="Open folder" Margin="0,0,8,0" Padding="12,6" FontSize="12" ToolTip="Show this file in File Explorer" />
                <Button x:Name="ReloadBtn" Click="Reload_Click" Content="↻ Reload" Margin="0,0,8,0" Padding="12,6" FontSize="12" ToolTip="Discard unsaved changes and read the file again" />
                <Button x:Name="SaveBtn" Click="Save_Click" Content="Save" Margin="0" Padding="18,6" FontSize="12" FontWeight="SemiBold" Background="#0E7490"
                        ToolTip="Write the list to the file (Ctrl+S)" />
            </StackPanel>
            <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="2,0,12,0" />
        </DockPanel>
    </Grid>
</Window>
