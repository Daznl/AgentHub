<Window x:Class="AgentHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:terminal="clr-namespace:AgentHub.Terminal"
        Title="AgentHub - Repository &amp; Agent Cockpit" Height="860" Width="1340" MinHeight="680" MinWidth="1020">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Navigation & Action Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock FontSize="26" FontWeight="SemiBold" Text="AgentHub" />
                    <TextBlock Foreground="{StaticResource MutedBrush}" Text="Repos, GitHub and interchangeable coding agents in one cockpit" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ViewCockpitBtn" Click="ViewCockpitBtn_Click" Content="⚡ Cockpit" FontWeight="SemiBold" />
                    <Button x:Name="ManageReposBtn" Click="ManageReposBtn_Click" Content="🔧 Manage GitHub Repos" FontWeight="SemiBold" />
                    <Button Click="OpenSettings_Click" Content="Settings" />
                </StackPanel>
            </DockPanel>

            <!-- Secondary management toolbar (only visible inside the Manage GitHub Repos area) -->
            <Border x:Name="ManageBar" Visibility="Collapsed" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8,8,8,0" Margin="0,12,0,0">
                <WrapPanel Orientation="Horizontal">
                    <Button x:Name="ViewReposBtn" Click="ViewReposBtn_Click" Content="📁 Local Repos" Background="#3b82f6" FontWeight="SemiBold" />
                    <Button x:Name="ViewGitHubBtn" Click="ViewGitHubBtn_Click" Content="🐙 GitHub Repos" FontWeight="SemiBold" />
                    <Border Width="1" Background="{StaticResource BorderBrush}" Margin="6,0,10,8" />
                    <Button Click="ScanFolder_Click" Content="🔍 Scan for repos" Background="#047857" FontWeight="SemiBold" ToolTip="Scan Desktop or folder to find and import existing Git repositories" />
                    <Button Click="AddExisting_Click" Content="Add existing repo" />
                    <Button Click="CloneRepo_Click" Content="Clone from GitHub" />
                </WrapPanel>
            </Border>
        </StackPanel>

        <!-- Main Content Area: View 1 (Repositories) or View 2 (Cockpit) -->
        <Grid Grid.Row="1">
            <!-- VIEW 1: REPOSITORIES & GIT -->
            <Grid x:Name="RepoViewGrid" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="310" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="4,4,4,10">
                            <TextBlock FontWeight="SemiBold" Text="Repositories" />
                            <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12" Text="Select a local Git repository" />
                        </StackPanel>
                        <ListBox x:Name="RepoList" SelectionChanged="RepoList_SelectionChanged" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="4,5" Margin="0,0,0,2">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Background="{Binding StatusBadgeBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="4,0,0,0">
                                                <TextBlock Text="{Binding StatusBadgeText}" Foreground="{Binding StatusTextBrush}" FontSize="10" FontWeight="SemiBold" />
                                            </Border>
                                            <StackPanel DockPanel.Dock="Left">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextBrush}" />
                                                <TextBlock Text="{Binding LocalPath}" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" MaxWidth="190" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="RepoDetail" Visibility="Collapsed">
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="RepoNameText" FontSize="24" FontWeight="SemiBold" />
                                    <TextBlock x:Name="RepoPathText" Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Click="OpenFolder_Click" Content="Open folder" />
                                    <Button Click="OpenGitHub_Click" Content="GitHub" />
                                    <Button Click="RemoveRepo_Click" Content="Remove" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,12">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <TextBlock DockPanel.Dock="Left" FontSize="18" FontWeight="SemiBold" Text="Git status" />
                                    <Button DockPanel.Dock="Right" Click="RefreshGit_Click" Content="Refresh" />
                                </DockPanel>
                                <UniformGrid Columns="4" Margin="0,0,0,10">
                                    <StackPanel><TextBlock Foreground="{StaticResource MutedBrush}" Text="Branch"/><TextBlock x:Name="BranchText" FontSize="18"/></StackPanel>
                                    <StackPanel><TextBlock Foreground="{StaticResource MutedBrush}" Text="Changes"/><TextBlock x:Name="ChangesText" FontSize="18"/></StackPanel>
                                    <StackPanel><TextBlock Foreground="{StaticResource MutedBrush}" Text="Ahead"/><TextBlock x:Name="AheadText" FontSize="18"/></StackPanel>
                                    <StackPanel><TextBlock Foreground="{StaticResource MutedBrush}" Text="Behind"/><TextBlock x:Name="BehindText" FontSize="18"/></StackPanel>
                                </UniformGrid>
                                <TextBlock x:Name="RemoteText" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
                                <WrapPanel>
                                    <Button Click="Fetch_Click" Content="Fetch" />
                                    <Button Click="Pull_Click" Content="Pull (fast-forward)" />
                                    <Button Click="Push_Click" Content="Push" />
                                </WrapPanel>
                                <TextBox x:Name="GitOutput" Height="100" Margin="0,6,0,0" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" TextWrapping="NoWrap" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="Coding agent &amp; Embedded Cockpit" />
                                <TextBlock Margin="0,4,0,12" Foreground="{StaticResource MutedBrush}" Text="Launch an interchangeable CLI directly in this repo or inside the embedded dual-terminal cockpit." TextWrapping="Wrap" />
                                <WrapPanel VerticalAlignment="Center">
                                    <ComboBox x:Name="AgentCombo" Width="200" DisplayMemberPath="Name" />
                                    <Button Click="LaunchCockpit1_Click" Content="⚡ Launch in T1" Background="#2563eb" FontWeight="SemiBold" ToolTip="Launch in Terminal 1" />
                                    <Button Click="LaunchCockpit2_Click" Content="⚡ Launch in T2" Background="#7c3aed" FontWeight="SemiBold" ToolTip="Launch in Terminal 2" />
                                    <Button Click="LaunchCockpit3_Click" Content="⚡ Launch in T3" Background="#059669" FontWeight="SemiBold" ToolTip="Launch in Terminal 3" />
                                    <Button Click="LaunchAgent_Click" Content="External Window" />
                                    <Button Click="OpenHandoff_Click" Content="Open handoff" />
                                </WrapPanel>
                                <TextBlock x:Name="AgentCommandPreview" Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" FontFamily="Consolas" />
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                            <StackPanel>
                                <TextBlock FontSize="18" FontWeight="SemiBold" Text="Agent handoff" />
                                <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                           Text="AgentHub keeps .agenthub/handoff.md inside each repository. Use it to record the current task, completed work, next steps and relevant files before swapping agents." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- VIEW 2: GITHUB REPOSITORIES BROWSER -->
            <Grid x:Name="GitHubViewGrid" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- GitHub Top Filter & Search Bar -->
                <Border Grid.Row="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🐙 Remote Repositories" FontWeight="SemiBold" FontSize="16" Foreground="{StaticResource TextBrush}" />
                                <TextBlock x:Name="GitHubAccountText" Text="Loading GitHub account..." Foreground="{StaticResource AccentBrush}" FontSize="13" Margin="10,0,0,0" VerticalAlignment="Center" />
                                <ComboBox x:Name="GitHubAccountCombo" MinWidth="190" Margin="10,0,0,0" Padding="6,3" VerticalAlignment="Center" Visibility="Collapsed"
                                          SelectionChanged="GitHubAccountCombo_SelectionChanged"
                                          ToolTip="Accounts known to GitHub CLI. Pick one to make it the active account." />
                                <Button Click="SignInGitHub_Click" Content="➕ Sign in" Margin="8,0,0,0" Padding="10,4" FontSize="12"
                                        ToolTip="Sign in to another GitHub account with a real browser verification (gh auth login --web)" />
                                <Button x:Name="GitHubSignOutButton" Click="SignOutGitHub_Click" Content="Sign out" Margin="4,0,0,0" Padding="10,4" FontSize="12" Visibility="Collapsed"
                                        ToolTip="Remove the selected account from GitHub CLI (gh auth logout)" />
                            </StackPanel>
                            <TextBlock x:Name="GitHubRepoCountText" Text="Browse, search and 1-click clone your GitHub repositories directly into AgentHub" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBox x:Name="GitHubSearchBox" Width="180" Margin="0,0,8,0" TextChanged="GitHubSearchBox_TextChanged" ToolTip="Filter by name or description..." />
                            <ComboBox x:Name="GitHubVisibilityFilter" Width="200" Margin="0,0,8,0" SelectionChanged="GitHubVisibilityFilter_SelectionChanged">
                                <ComboBoxItem Content="All Repositories" Tag="all" IsSelected="True" />
                                <ComboBoxItem Content="✎ I can push" Tag="push" />
                                <ComboBoxItem Content="👁 Read-only (clone only)" Tag="readonly" />
                                <ComboBoxItem Content="👤 Owned by me" Tag="mine" />
                                <ComboBoxItem Content="🏢 Organisation repos" Tag="org" />
                                <ComboBoxItem Content="📦 Archived" Tag="archived" />
                                <Separator />
                                <ComboBoxItem Content="✓ Up to date" Tag="uptodate" />
                                <ComboBoxItem Content="⇣ Behind (Needs Pull)" Tag="behind" />
                                <ComboBoxItem Content="⇡ Ahead of Origin" Tag="ahead" />
                                <ComboBoxItem Content="✎ Uncommitted Changes" Tag="dirty" />
                                <ComboBoxItem Content="Not in AgentHub" Tag="notadded" />
                                <ComboBoxItem Content="In AgentHub" Tag="added" />
                                <ComboBoxItem Content="Private Only" Tag="private" />
                                <ComboBoxItem Content="Public Only" Tag="public" />
                            </ComboBox>
                            <Button Click="AutoDetectRepos_Click" Content="🔍 Auto-Detect Local" Background="#065f46" FontWeight="SemiBold" Margin="0,0,6,0" Padding="10,6" ToolTip="Scan Desktop and project folders to auto-link existing clones" />
                            <Button Click="CheckAllSync_Click" Content="🔄 Check Sync" Margin="0,0,6,0" Padding="10,6" ToolTip="Run git status and fetch across all linked repositories" />
                            <Button Click="RefreshGitHub_Click" Content="Refresh" Margin="0" Padding="10,6" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- GitHub Repo Content Area -->
                <Grid Grid.Row="1">
                    <!-- Auth Warning Banner if gh is not authenticated -->
                    <Border x:Name="GitHubAuthWarning" Visibility="Collapsed" Background="#27272a" BorderBrush="#ef4444" BorderThickness="1" CornerRadius="8" Padding="28" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="540">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="⚠️ GitHub CLI Not Authenticated" FontWeight="Bold" FontSize="17" Foreground="#ef4444" HorizontalAlignment="Center" />
                            <TextBlock Text="AgentHub uses your local GitHub CLI (`gh`) so you never have to paste personal access tokens or credentials into the app. Sign in here and approve the one-time code on github.com in your browser." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,10,0,16" TextAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Click="SignInGitHub_Click" Content="🐙 Sign in with GitHub" Background="#2563eb" FontWeight="SemiBold" Padding="16,8" />
                                <Button Click="LoginGitHubInCockpit_Click" Content="⚡ Use terminal instead" Padding="16,8" ToolTip="Runs gh auth login interactively in a Cockpit terminal pane" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Loading Text -->
                    <TextBlock x:Name="GitHubLoadingText" Text="Fetching your GitHub repositories via GitHub CLI..." Foreground="{StaticResource MutedBrush}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />

                    <!-- Repos List: virtualised ListBox so hundreds of org repos render instantly; grouped by access category -->
                    <ListBox x:Name="GitHubRepoList" Background="Transparent" BorderThickness="0" Padding="0"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                             VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="GroupItem">
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                        <Setter Property="Margin" Value="0" />
                                        <Setter Property="Padding" Value="0" />
                                    </Style>
                                </GroupStyle.ContainerStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0,6,0,10" Background="#111317">
                                            <Border DockPanel.Dock="Right" Background="#1e293b" CornerRadius="10" Padding="8,2" VerticalAlignment="Center" Margin="8,0,4,0">
                                                <TextBlock Text="{Binding ItemCount}" Foreground="#94a3b8" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Details -->
                                            <StackPanel Grid.Column="0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding NameWithOwner}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource TextBrush}" Cursor="Hand" MouseDown="GitHubRepoTitle_MouseDown" Tag="{Binding Url}" ToolTip="Click to open on GitHub" />
                                                    <Border Background="{Binding VisibilityBadgeBrush}" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding VisibilityLabel}" Foreground="{Binding VisibilityTextBrush}" FontSize="11" FontWeight="SemiBold" />
                                                    </Border>
                                                    <Border Background="{Binding AccessBadgeBrush}" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="{Binding AccessTooltip}">
                                                        <TextBlock Text="{Binding AccessLabel}" Foreground="{Binding AccessTextBrush}" FontSize="11" FontWeight="SemiBold" />
                                                    </Border>
                                                    <Border Visibility="{Binding AddedBadgeVisibility}" Background="#1e293b" CornerRadius="4" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="✓ In AgentHub" Foreground="#94a3b8" FontSize="11" FontWeight="SemiBold" />
                                                    </Border>
                                                    <Border Background="{Binding SyncStatusBadgeBrush}" CornerRadius="4" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SyncStatusText}" Foreground="{Binding SyncStatusTextBrush}" FontSize="11" FontWeight="Bold" />
                                                    </Border>
                                                </StackPanel>

                                                <TextBlock Text="{Binding DisplayDescription}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,8" FontSize="13" />

                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding OwnerLabel}" Foreground="#a1a1aa" FontSize="11" ToolTip="Repository owner" />
                                                    <TextBlock Text="{Binding PushedAtFormatted}" Foreground="#71717a" FontSize="11" Margin="14,0,0,0" />
                                                    <TextBlock Text="{Binding LocalPathFormatted}" Foreground="#60a5fa" FontSize="11" Margin="14,0,0,0" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Actions -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                                <Button Tag="{Binding}" Visibility="{Binding PullButtonVisibility}" Click="GitHubPull_Click" Content="⬇ Pull (fast-forward)" Background="#d97706" FontWeight="SemiBold" Padding="12,7" Margin="0,0,8,0" />
                                                <Button Tag="{Binding}" Visibility="{Binding PushButtonVisibility}" Click="GitHubPush_Click" Content="⬆ Push" Background="#2563eb" FontWeight="SemiBold" Padding="12,7" Margin="0,0,8,0" />
                                                <Border Visibility="{Binding PushBlockedVisibility}" Background="#3f1d1d" BorderBrush="#7f1d1d" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,8,0" VerticalAlignment="Center" ToolTip="{Binding AccessTooltip}">
                                                    <TextBlock Text="⬆ Push blocked · read-only" Foreground="#fca5a5" FontSize="12" FontWeight="SemiBold" />
                                                </Border>
                                                <Button Tag="{Binding}" Visibility="{Binding CockpitButtonVisibility}" Click="GitHubCockpit_Click" Content="⚡ Cockpit" Background="#7c3aed" FontWeight="SemiBold" Padding="12,7" Margin="0,0,8,0" />
                                                <Button Tag="{Binding}" Click="GitHubAction_Click" Content="{Binding ActionButtonText}" Background="{Binding ActionButtonBrush}" FontWeight="SemiBold" Padding="14,7" Margin="0,0,8,0" />
                                                <Button Tag="{Binding Url}" Click="OpenGitHubUrl_Click" Content="🌐 GitHub" Padding="10,7" Margin="0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>

            <!-- VIEW 3: MULTI-SESSION COCKPIT (DYNAMIC MULTI-TERMINAL HOST) -->
            <Grid x:Name="CockpitViewGrid" Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Cockpit Top Bar -->
                <Border Grid.Row="0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚡ Multi-Terminal Cockpit" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource TextBrush}" />
                                <Border Background="#065f46" CornerRadius="4" Margin="10,0,0,0" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock x:Name="TerminalCountBadge" Text="1 SESSION" Foreground="#34d399" FontSize="10" FontWeight="Bold" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Side-by-side interactive ConPTY sessions with dynamic split panes, ANSI/VT support, and fast terminal switching" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Click="OpenPowerShellInFolder_Click" Content="📂 PowerShell in Folder…" Background="#0f766e" FontWeight="SemiBold" Padding="12,6" Margin="0,0,8,0" ToolTip="Browse for any folder and open a plain PowerShell session there in a new terminal pane" />
                            <Button Click="AddTerminal_Click" Content="➕ Add Terminal" Background="#2563eb" FontWeight="SemiBold" Padding="12,6" Margin="0" ToolTip="Add another side-by-side terminal session" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Provider usage limits -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="2,0,0,5">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Usage limits" FontWeight="SemiBold" FontSize="13" />
                            <Border Background="#1e293b" CornerRadius="4" Margin="10,0,0,0" Padding="6,2" VerticalAlignment="Center">
                                <TextBlock x:Name="UsagePollingBadge" Text="IDLE · POLLING EVERY 15M" Foreground="#94a3b8" FontSize="10" FontWeight="Bold" />
                            </Border>
                            <TextBlock x:Name="UsageRefreshStatusText" Text="Waiting for refresh" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="10,1,0,0" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock Text="Refresh every" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,5,0" />
                            <TextBox x:Name="UsageIntervalBox" Width="46" Padding="4,2" Margin="0,0,3,0" FontSize="11" VerticalContentAlignment="Center" TextAlignment="Center" KeyDown="UsageIntervalBox_KeyDown" LostFocus="UsageIntervalBox_LostFocus" ToolTip="How often to refresh usage, in minutes (e.g. 2, 0.5). Cheap now — no terminal scraping." />
                            <TextBlock Text="min" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,10,0" />
                            <Button x:Name="ToggleRawOutputBtn" Click="ToggleRawOutput_Click" Content="Terminal Feed ▾" Padding="9,4" Margin="0,0,8,0" FontSize="11" ToolTip="Inspect raw CLI terminal capture output" />
                            <Button x:Name="UsageRefreshButton" Click="RefreshUsage_Click" Content="Refresh usage" Padding="9,4" Margin="0" FontSize="11" />
                        </StackPanel>
                    </DockPanel>

                    <ItemsControl x:Name="UsageCards" Grid.Row="1">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="11,8" Margin="0,0,8,0" MinHeight="150">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,5">
                                            <Border DockPanel.Dock="Left" Width="3" Height="16" Background="{Binding AccentBrush}" Margin="0,0,7,0" />
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextBrush}" />
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" />
                                        </DockPanel>
                                        <ItemsControl ItemsSource="{Binding Limits}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="108" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="62" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextBrush}" />
                                                        <ProgressBar Grid.Column="1" Height="6" Margin="6,0" Minimum="0" Maximum="100" Value="{Binding RemainingPercent}" Foreground="{Binding BarBrush}" Background="#343841" BorderThickness="0" />
                                                        <TextBlock Grid.Column="2" Text="{Binding ValueText}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{StaticResource TextBrush}" />
                                                        <TextBlock Grid.Column="3" Text="{Binding ResetText}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="8,0,0,0" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding SourceText}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border x:Name="UsageEmptyNotice" Grid.Row="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="14,10" Visibility="Collapsed">
                        <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11" Text="No usage providers are currently active. You can configure custom usage acquisition commands or scripts in Settings &gt; settings.json." />
                    </Border>

                    <!-- Collapsible Split Terminal Output Panel (Per-Provider Feeds) -->
                    <Border x:Name="RawOutputPanel" Grid.Row="2" Background="#111317" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,8,0,0" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Tab selector header & controls -->
                            <DockPanel Grid.Row="0" Margin="0,0,0,8">
                                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Terminal Feeds:" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <Button x:Name="FeedTabAntigravity" Click="FeedTab_Click" Tag="gemini" Content="✦ Antigravity" Padding="10,3" Margin="0,0,6,0" FontSize="11" FontWeight="SemiBold" Background="#2563eb" Foreground="White" />
                                    <Button x:Name="FeedTabCodex" Click="FeedTab_Click" Tag="codex" Content="⚡ Codex" Padding="10,3" Margin="0,0,6,0" FontSize="11" FontWeight="SemiBold" Background="#27272a" Foreground="#a1a1aa" />
                                    <Button x:Name="FeedTabClaude" Click="FeedTab_Click" Tag="claude" Content="✻ Claude Code" Padding="10,3" Margin="0,0,6,0" FontSize="11" FontWeight="SemiBold" Background="#27272a" Foreground="#a1a1aa" />
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Click="CopyCurrentFeed_Click" Content="📋 Copy" Padding="7,2" Margin="0,0,6,0" FontSize="10" ToolTip="Copy active terminal output to clipboard" />
                                    <Button x:Name="RawAnsiToggleBtn" Click="ToggleRawAnsi_Click" Content="Sanitized" Padding="7,2" Margin="0,0,8,0" FontSize="10" ToolTip="Toggle between clean sanitized output and raw ANSI bytes" />
                                    <Button Click="ToggleRawOutput_Click" Content="✕ Close" Padding="7,2" Margin="0" FontSize="10" />
                                </StackPanel>
                            </DockPanel>

                            <!-- Active Provider Feed Details & Monospace Output -->
                            <Border Grid.Row="1" Background="#090a0f" BorderBrush="#27272a" BorderThickness="1" CornerRadius="4" Padding="10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                        <TextBlock x:Name="FeedHeaderMeta" Text="Provider: Antigravity | Source: agy -p /usage" Foreground="{StaticResource MutedBrush}" FontSize="11" FontFamily="Consolas, Cascadia Code, monospace" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Border DockPanel.Dock="Right" x:Name="FeedStatusBadgeBorder" Background="#065f46" CornerRadius="3" Padding="6,1" Margin="8,0,0,0">
                                            <TextBlock x:Name="FeedStatusBadge" Text="AVAILABLE" Foreground="#34d399" FontSize="9" FontWeight="Bold" />
                                        </Border>
                                    </DockPanel>
                                    <TextBox x:Name="ActiveFeedTextBox" Grid.Row="1" Background="Transparent" Foreground="#e4e4e7" FontFamily="Consolas, Cascadia Code, monospace" FontSize="11" TextWrapping="NoWrap" AcceptsReturn="True" IsReadOnly="True" MaxHeight="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0" Text="No terminal capture data yet. Click 'Refresh usage' to capture." />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Dynamic Multi-Terminal Split Grid -->
                <Grid Grid.Row="2" x:Name="TerminalsContainerGrid">
                </Grid>
            </Grid>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Margin="0,14,0,0" Padding="10,6" Background="{StaticResource PanelBrush}" CornerRadius="6">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" Text="Ready" />
        </Border>
    </Grid>
</Window>
