<UserControl x:Class="AgentHub.Terminal.EmbeddedTerminalControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <Grid Background="#18181b">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#27272a" BorderBrush="#3f3f46" BorderThickness="0,0,0,1" Padding="8,6">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#71717a" Margin="0,0,8,0" />
                    <TextBlock x:Name="TitleText" Text="Terminal" FontWeight="SemiBold" Foreground="#f4f4f5" FontSize="12" />
                    <TextBlock x:Name="SubtitleText" Text="" Foreground="#a1a1aa" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" HorizontalAlignment="Right">
                    <Button x:Name="RestartBtn" Content="Restart" Click="RestartBtn_Click" Margin="0,0,6,0" Padding="8,2" FontSize="11" Visibility="Collapsed" />
                    <Button x:Name="StopBtn" Content="Stop" Click="StopBtn_Click" Padding="8,2" FontSize="11" />
                </StackPanel>
            </DockPanel>
        </Border>

        <wv2:WebView2 Grid.Row="1" x:Name="WebView" />
    </Grid>
</UserControl>
