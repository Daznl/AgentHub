<UserControl x:Class="AgentHub.Terminal.EmbeddedTerminalControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <!-- Header (status dot, subtitle, Restart/Stop) lives in the outer TerminalPaneControl
         so the whole pane shares a single top bar. This control is just the terminal surface. -->
    <Grid Background="#0A0F17">
        <wv2:WebView2 x:Name="WebView" />
    </Grid>
</UserControl>
