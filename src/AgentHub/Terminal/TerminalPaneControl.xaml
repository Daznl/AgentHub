<UserControl x:Class="AgentHub.Terminal.TerminalPaneControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:terminal="clr-namespace:AgentHub.Terminal">
    <UserControl.Resources>
        <!-- Launcher step card: active (list open), done (one line + Change) or pending (dimmed) -->
        <Style x:Key="StepCard" TargetType="Border">
            <Setter Property="Background" Value="#0E1622" />
            <Setter Property="BorderBrush" Value="#1E2C40" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="StepBadge" TargetType="Border">
            <Setter Property="DockPanel.Dock" Value="Left" />
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="#16202F" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StepBadgeText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="StepLabel" TargetType="TextBlock">
            <Setter Property="DockPanel.Dock" Value="Left" />
            <Setter Property="Foreground" Value="#7E8CA6" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="100" />
        </Style>
        <Style x:Key="StepValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="StepChangeButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="PickButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <!-- Repository and CLI rows; the current choice is outlined -->
        <DataTemplate x:Key="PickRowTemplate">
            <Button Click="PickRow_Click" Tag="{Binding}" ToolTip="{Binding Meta}" AutomationProperties.Name="{Binding Title}">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource PickButton}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter Property="Background" Value="#13263A" />
                                <Setter Property="BorderBrush" Value="#24506A" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Meta}" FontSize="10" Foreground="#7E8CA6" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- The orchestrator attached to this pane's session (🧭 Orchestrate), in a small box above it. Every other pane
         (the owner's own terminals) never shows it. -->
    <Border x:Name="OrchestratorBox" Grid.Row="0" Visibility="Collapsed" Background="#151129" BorderBrush="#4C3A8C" BorderThickness="1"
            CornerRadius="8" Padding="10,6" Margin="0,0,0,6">
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <!-- The context limit at which the session hands off, changeable while the orchestrator runs. -->
                <StackPanel x:Name="OrchestratorThresholdRow" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0"
                            ToolTip="Hand off to a fresh session when the context window reaches this share (40–95 %). Applies at once: set it below what the session uses now and it hands off straight away. Enter or Tab applies.">
                    <TextBlock x:Name="OrchestratorContextUsed" Foreground="#9A8FC7" FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Handoff at" Foreground="#C4B5FD" FontSize="10" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox x:Name="OrchestratorThresholdBox" Width="34" FontSize="11" Padding="4,1" TextAlignment="Right" VerticalContentAlignment="Center"
                             Background="#0F0C1F" Foreground="#E2E8F0" BorderBrush="#4C3A8C" CaretBrush="#C4B5FD"
                             PreviewKeyDown="OrchestratorThreshold_PreviewKeyDown" LostKeyboardFocus="OrchestratorThreshold_LostFocus"
                             AutomationProperties.Name="Handoff limit, per cent of the context window" />
                    <TextBlock Text="%" Foreground="#C4B5FD" FontSize="10" VerticalAlignment="Center" Margin="2,0,0,0" />
                </StackPanel>
                <Button x:Name="OrchestratorRunBtn" Click="OrchestratorRun_Click" Content="🗺 Run" Visibility="Collapsed"
                        ToolTip="Open the tree of the advanced template this orchestrator follows: where the run stands, ▶ Go, ⏸ Pause, and going on from any step"
                        Background="#221A3D" Foreground="#C4B5FD" Padding="8,2" FontSize="11" FontWeight="SemiBold" Margin="0,0,6,0" />
                <Button x:Name="OrchestratorDetachBtn" Click="OrchestratorDetach_Click" Content="✕ Detach"
                        ToolTip="Take the orchestrator off this session: the session carries on as your own, and your typing goes straight to it again"
                        Background="#221A3D" Foreground="#C4B5FD" Padding="8,2" FontSize="11" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel>
                <DockPanel LastChildFill="True">
                    <TextBlock DockPanel.Dock="Left" Text="🧠 ORCHESTRATOR" Foreground="#A78BFA" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Border DockPanel.Dock="Left" x:Name="OrchestratorStateChip" Background="#2E2357" CornerRadius="4" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock x:Name="OrchestratorStateText" Foreground="#DDD6FE" FontSize="10" FontWeight="Bold" />
                    </Border>
                    <!-- The orchestrator's own context window (its headless Claude session), read from its transcript after each decision. -->
                    <Border DockPanel.Dock="Left" x:Name="OrchestratorContextBadge" Visibility="Collapsed" Background="#0F0C1F" BorderBrush="#4C3A8C" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="36" Height="4" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Border Background="#2E2357" CornerRadius="2" />
                                <Border x:Name="OrchestratorContextFill" Background="#22C55E" CornerRadius="2" HorizontalAlignment="Left" Width="0" />
                            </Grid>
                            <TextBlock x:Name="OrchestratorContextText" Foreground="#C4B5FD" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="OrchestratorTitle" Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <TextBlock x:Name="OrchestratorProgress" Foreground="#B6C2D6" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DockPanel>
        <!-- Every message of the current worker session, oldest first; follows the newest unless scrolled up. -->
        <ScrollViewer x:Name="OrchestratorConversationScroll" Grid.Row="1" MaxHeight="220" Margin="0,6,0,0"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock x:Name="OrchestratorNothingYet" Foreground="#7E8CA6" FontSize="10" TextWrapping="Wrap" />
                <ItemsControl x:Name="OrchestratorConversation" ItemTemplate="{StaticResource OrchestratorExchangeTemplate}" />
            </StackPanel>
        </ScrollViewer>
        <!-- Attached orchestrator only: what the owner types here goes to the orchestrator, never straight to the session. -->
        <DockPanel x:Name="OrchestratorInputRow" Grid.Row="2" LastChildFill="True" Margin="0,6,0,0">
            <Button x:Name="OrchestratorSendBtn" DockPanel.Dock="Right" Click="OrchestratorSend_Click" Content="Send" ToolTip="Send to the orchestrator (Enter; Shift+Enter for a new line)"
                    Background="#4C3A8C" Foreground="#EDE9FE" Padding="10,2" Margin="6,0,0,0" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Bottom" />
            <TextBox x:Name="OrchestratorInput" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="90" VerticalScrollBarVisibility="Auto" FontSize="12" Padding="8,4"
                     Background="#0F0C1F" Foreground="#E2E8F0" BorderBrush="#4C3A8C" CaretBrush="#C4B5FD" PreviewKeyDown="OrchestratorInput_PreviewKeyDown"
                     AutomationProperties.Name="Message the orchestrator" ToolTip="Message the orchestrator: the job, how to run it, questions. Enter sends." />
        </DockPanel>
        </Grid>
    </Border>

    <Border x:Name="PaneBorder" Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Pane Top Control Bar -->
            <!-- Two rows: title above, buttons below. Both modes (setup / session running) keep the same height,
                 so starting a session never resizes the terminal while the CLI draws its first screen. -->
            <Border x:Name="PaneHeader" Grid.Row="0" Background="#0E1622" BorderBrush="#1E2C40" BorderThickness="0,0,0,1" Padding="8,6">
                <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Title row: status dot, repository or folder name, then the session's status line -->
                <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,6">
                    <Ellipse x:Name="StatusDot" DockPanel.Dock="Left" Width="8" Height="8" Fill="#5A6B85" Margin="1,0,8,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="SessionTitle" DockPanel.Dock="Left" Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,10,0" MaxWidth="360" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="SubtitleText" Text="" Foreground="#7E8CA6" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </DockPanel>

                <DockPanel Grid.Row="1" LastChildFill="True" MinHeight="26">
                    <!-- Actions docked right FIRST so they always keep their full width -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BrowseBtn" Click="BrowseFolder_Click" Content="📂" Background="#16202F" Foreground="#7E8CA6" Padding="7,3" Margin="0,0,4,0" FontSize="11" FontWeight="Bold" />
                        <Button x:Name="LaunchBtn" Click="Launch_Click" Content="Relaunch" Margin="0,0,4,0" Padding="8,3" FontWeight="SemiBold" Background="#0E7490" FontSize="11" />
                        <Button x:Name="OrchestrateBtn" Click="Orchestrate_Click" Content="🧭 Orchestrate" Visibility="Collapsed"
                                ToolTip="Put an orchestrator on this session: your messages go to it, it answers you and instructs the session. Take it off any time."
                                Background="#221A3D" Foreground="#C4B5FD" Padding="8,3" Margin="0,0,4,0" FontSize="11" FontWeight="SemiBold" />
                        <Button x:Name="RepoContextBtn" Click="RepoContext_Click" Content="📁 Repo context" Background="#16202F" Foreground="#B6C2D6" Padding="8,3" Margin="0,0,4,0" FontSize="11" FontWeight="SemiBold" />
                        <Button x:Name="TimelineBtn" Click="Timeline_Click" Content="🌳" ToolTip="Timeline of this repository: every session and commit from the start, parallel sessions side by side" Background="#16202F" Foreground="#7E8CA6" Padding="7,3" Margin="0,0,4,0" FontSize="11" FontWeight="Bold" />
                        <Button x:Name="HistoryBtn" Click="History_Click" Content="🕘" ToolTip="Open the full history of this pane's session, or of the selected folder's sessions" Background="#16202F" Foreground="#7E8CA6" Padding="7,3" Margin="0,0,4,0" FontSize="11" FontWeight="Bold" />
                        <Button x:Name="MoveLeftBtn" Click="MoveLeft_Click" Content="◀" ToolTip="Move this terminal left" Background="#16202F" Foreground="#7E8CA6" Padding="7,3" Margin="0,0,4,0" FontSize="11" FontWeight="Bold" />
                        <Button x:Name="MoveRightBtn" Click="MoveRight_Click" Content="▶" ToolTip="Move this terminal right" Background="#16202F" Foreground="#7E8CA6" Padding="7,3" Margin="0,0,4,0" FontSize="11" FontWeight="Bold" />
                        <Button x:Name="RestartBtn" Click="RestartBtn_Click" Content="Restart" ToolTip="Re-launch the last command in this pane" Visibility="Collapsed" Padding="8,3" Margin="0,0,4,0" FontSize="11" />
                        <Button x:Name="StopBtn" Click="StopBtn_Click" Content="Stop" ToolTip="Stop the running session" Visibility="Collapsed" Padding="8,3" Margin="0,0,4,0" FontSize="11" />
                        <Button Click="Close_Click" Content="✕" ToolTip="Close this terminal session" Background="#16202F" Foreground="#7E8CA6" Padding="7,3" Margin="0" FontSize="11" FontWeight="Bold" />
                    </StackPanel>

                    <!-- Shown when the agent CLI in this pane has stopped and is waiting for the user -->
                    <Border x:Name="AttentionBadge" DockPanel.Dock="Left" Visibility="Collapsed" Background="#78350F" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="⏳ WAITING FOR YOU" Foreground="#FCD34D" FontSize="10" FontWeight="Bold" />
                    </Border>

                    <!-- Context window fill for Claude Code / Codex sessions, read from the CLI's own transcript -->
                    <Border x:Name="ContextBadge" DockPanel.Dock="Left" Visibility="Collapsed" Background="#111C2B" BorderBrush="#24344B" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="36" Height="4" VerticalAlignment="Center" Margin="0,0,6,0">
                                <Border Background="#24344B" CornerRadius="2" />
                                <Border x:Name="ContextBarFill" Background="#22C55E" CornerRadius="2" HorizontalAlignment="Left" Width="0" />
                            </Grid>
                            <TextBlock x:Name="ContextText" Foreground="#B6C2D6" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Fills the space between the badges and the buttons -->
                    <Border />
                </DockPanel>
                </Grid>
            </Border>

            <!-- Last prompt the user sent, read from the CLI's transcript so it never needs scrolling back for -->
            <Border x:Name="PromptStrip" Grid.Row="1" Visibility="Collapsed" Background="#0B121C" BorderBrush="#1E2C40" BorderThickness="0,0,0,1" Padding="8,4">
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" x:Name="PromptCopyBtn" Click="PromptCopy_Click" Content="Copy" ToolTip="Copy the full prompt" VerticalAlignment="Top" Background="#16202F" Foreground="#7E8CA6" Padding="7,1" Margin="8,0,0,0" FontSize="10" FontWeight="SemiBold" />
                    <TextBlock DockPanel.Dock="Left" x:Name="PromptLabel" Text="LAST PROMPT" Foreground="#5A6B85" FontSize="9" FontWeight="Bold" VerticalAlignment="Top" Margin="0,2,8,0" />
                    <ScrollViewer x:Name="PromptScroller" MaxHeight="18" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled" Cursor="Hand" MouseLeftButtonUp="PromptText_Click">
                        <TextBlock x:Name="PromptText" Foreground="#B6C2D6" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Embedded Terminal. Hidden (never collapsed) under the launcher, so it keeps its size and a new session starts at the final size. -->
            <terminal:EmbeddedTerminalControl Grid.Row="2" x:Name="Terminal" />

            <!-- Launcher, shown in place of the terminal while the pane has no session: repository, then CLI, then session -->
            <Border x:Name="LaunchPanel" Grid.Row="2" Background="#0A0F17">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel MaxWidth="520" Margin="16">
                        <TextBlock Text="Start a session" Foreground="{StaticResource TextBrush}" FontSize="15" FontWeight="SemiBold" Margin="2,0,0,12" />

                        <!-- Step 1: repository or folder -->
                        <Border x:Name="Step1Card" Style="{StaticResource StepCard}">
                            <StackPanel>
                                <DockPanel LastChildFill="True">
                                    <Button x:Name="Step1Change" DockPanel.Dock="Right" Click="Step1Change_Click" Content="Change" Style="{StaticResource StepChangeButton}" AutomationProperties.Name="Change repository" />
                                    <Border x:Name="Step1Badge" Style="{StaticResource StepBadge}"><TextBlock x:Name="Step1Number" Text="1" Style="{StaticResource StepBadgeText}" /></Border>
                                    <TextBlock Text="REPOSITORY" Style="{StaticResource StepLabel}" />
                                    <TextBlock x:Name="Step1Value" Style="{StaticResource StepValue}" />
                                </DockPanel>
                                <StackPanel x:Name="Step1Body" Margin="0,10,0,0">
                                    <TextBox x:Name="LocationFilter" TextChanged="LocationFilter_TextChanged" Margin="0,0,0,6" FontSize="12" Padding="8,4"
                                             ToolTip="Type to filter repositories and folders" AutomationProperties.Name="Filter repositories and folders" />
                                    <ItemsControl x:Name="LocationList" ItemTemplate="{StaticResource PickRowTemplate}" />
                                    <TextBlock x:Name="LocationEmpty" Text="No repository or folder matches." Foreground="#7E8CA6" FontSize="11" Margin="10,4,0,4" Visibility="Collapsed" />
                                    <!-- Folders with past Claude Code or Codex sessions on this computer, so they work without registering first -->
                                    <StackPanel x:Name="FoundSection" Visibility="Collapsed" Margin="0,8,0,0">
                                        <TextBlock Text="PAST SESSIONS ON THIS COMPUTER" Foreground="#5A6B85" FontSize="9" FontWeight="Bold" Margin="2,0,0,4"
                                                   ToolTip="Folders where Claude Code or Codex sessions ran, newest first, read from their transcripts on this computer" />
                                        <ItemsControl x:Name="FoundList" ItemTemplate="{StaticResource PickRowTemplate}" AutomationProperties.Name="Folders with past sessions" />
                                        <Button x:Name="FoundMoreBtn" Click="FoundMore_Click" Style="{StaticResource PickButton}" Visibility="Collapsed">
                                            <TextBlock x:Name="FoundMoreText" FontSize="12" Foreground="#7E8CA6" />
                                        </Button>
                                    </StackPanel>
                                    <Button Click="BrowseFolder_Click" Style="{StaticResource PickButton}" Margin="0,4,0,0">
                                        <TextBlock Text="📂 Browse for another folder…" FontSize="12" Foreground="#7E8CA6" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Step 2: function type: agent CLI, shell, or (from Home) a saved SSH connection -->
                        <Border x:Name="Step2Card" Style="{StaticResource StepCard}">
                            <StackPanel>
                                <DockPanel LastChildFill="True">
                                    <Button x:Name="Step2Change" DockPanel.Dock="Right" Click="Step2Change_Click" Content="Change" Style="{StaticResource StepChangeButton}" AutomationProperties.Name="Change function type" />
                                    <Border x:Name="Step2Badge" Style="{StaticResource StepBadge}"><TextBlock x:Name="Step2Number" Text="2" Style="{StaticResource StepBadgeText}" /></Border>
                                    <TextBlock Text="FUNCTION TYPE" Style="{StaticResource StepLabel}" />
                                    <TextBlock x:Name="Step2Value" Style="{StaticResource StepValue}" />
                                </DockPanel>
                                <ItemsControl x:Name="ShellList" Margin="0,10,0,0" ItemTemplate="{StaticResource PickRowTemplate}" />
                            </StackPanel>
                        </Border>

                        <!-- Step 3: new session, or continue one recorded for this folder (Claude Code and Codex) -->
                        <Border x:Name="Step3Card" Style="{StaticResource StepCard}">
                            <StackPanel>
                                <DockPanel LastChildFill="True">
                                    <Border x:Name="Step3Badge" Style="{StaticResource StepBadge}"><TextBlock Text="3" Style="{StaticResource StepBadgeText}" /></Border>
                                    <TextBlock Text="SESSION" Style="{StaticResource StepLabel}" />
                                    <TextBlock Style="{StaticResource StepValue}" />
                                </DockPanel>
                                <StackPanel x:Name="Step3Body" Margin="0,10,0,0">
                                    <Button x:Name="NewSessionBtn" Click="NewSession_Click" Style="{StaticResource PickButton}" Background="#0E7490" BorderBrush="#0E7490">
                                        <TextBlock Text="➕ New session" FontSize="12" FontWeight="SemiBold" />
                                    </Button>
                                    <TextBlock x:Name="ResumeStatus" Margin="10,8,10,4" Foreground="#7E8CA6" FontSize="11" TextWrapping="Wrap" />
                                    <ItemsControl x:Name="ResumeList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Click="ResumeItem_Click" Tag="{Binding}" ToolTip="{Binding FilePath}" AutomationProperties.Name="{Binding}" Style="{StaticResource PickButton}">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Meta}" FontSize="10" Foreground="#7E8CA6" TextTrimming="CharacterEllipsis" Margin="0,1,0,0" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Button x:Name="BackToOutputBtn" Click="BackToOutput_Click" Content="← Back to the last session's output" Style="{StaticResource StepChangeButton}"
                                HorizontalAlignment="Left" Margin="2,2,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
    </Grid>
</UserControl>
