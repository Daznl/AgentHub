<UserControl x:Class="AgentHub.Terminal.TerminalPaneControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:terminal="clr-namespace:AgentHub.Terminal">
    <Border x:Name="PaneBorder" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Pane Top Control Bar -->
            <Border x:Name="PaneHeader" Grid.Row="0" Background="#0E1622" BorderBrush="#1E2C40" BorderThickness="0,0,0,1" Padding="8,6">
                <DockPanel LastChildFill="True">
                    <!-- Actions docked right FIRST so they always keep their full width -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <ComboBox x:Name="RepoCombo" Width="130" Margin="0,0,4,0" DisplayMemberPath="Name" ToolTip="Select working repository" />
                        <ComboBox x:Name="ShellCombo" Width="110" Margin="0,0,4,0" ToolTip="Select agent CLI or shell" />
                        <Button Click="Launch_Click" Content="Launch" Margin="0,0,4,0" Padding="8,3" FontWeight="SemiBold" Background="#0E7490" FontSize="11" />
                        <Button Click="LaunchInFolder_Click" Content="📂" ToolTip="Browse for a folder and launch the selected shell/agent there (not limited to registered repos)" Background="#16202F" Foreground="#7E8CA6" Padding="7,3" Margin="0,0,4,0" FontSize="11" FontWeight="Bold" />
                        <Button x:Name="MoveLeftBtn" Click="MoveLeft_Click" Content="◀" ToolTip="Move this terminal left" Background="#16202F" Foreground="#7E8CA6" Padding="7,3" Margin="0,0,4,0" FontSize="11" FontWeight="Bold" />
                        <Button x:Name="MoveRightBtn" Click="MoveRight_Click" Content="▶" ToolTip="Move this terminal right" Background="#16202F" Foreground="#7E8CA6" Padding="7,3" Margin="0,0,4,0" FontSize="11" FontWeight="Bold" />
                        <Button x:Name="RestartBtn" Click="RestartBtn_Click" Content="Restart" ToolTip="Re-launch the last command in this pane" Visibility="Collapsed" Padding="8,3" Margin="0,0,4,0" FontSize="11" />
                        <Button x:Name="StopBtn" Click="StopBtn_Click" Content="Stop" ToolTip="Stop the running session" Visibility="Collapsed" Padding="8,3" Margin="0,0,4,0" FontSize="11" />
                        <Button Click="Close_Click" Content="✕" ToolTip="Close this terminal session" Background="#16202F" Foreground="#7E8CA6" Padding="7,3" Margin="0" FontSize="11" FontWeight="Bold" />
                    </StackPanel>

                    <!-- Status dot stays pinned to the left -->
                    <Ellipse x:Name="StatusDot" DockPanel.Dock="Left" Width="8" Height="8" Fill="#5A6B85" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <!-- Shown when the agent CLI in this pane has stopped and is waiting for the user -->
                    <Border x:Name="AttentionBadge" DockPanel.Dock="Left" Visibility="Collapsed" Background="#78350F" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="4" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="⏳ WAITING FOR YOU" Foreground="#FCD34D" FontSize="10" FontWeight="Bold" />
                    </Border>

                    <!-- Subtitle fills the remaining middle and truncates before the dropdowns -->
                    <TextBlock x:Name="SubtitleText" Text="" Foreground="#7E8CA6" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                </DockPanel>
            </Border>

            <!-- Embedded Terminal -->
            <terminal:EmbeddedTerminalControl Grid.Row="1" x:Name="Terminal" />
        </Grid>
    </Border>
</UserControl>
