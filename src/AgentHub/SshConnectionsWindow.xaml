<Window x:Class="AgentHub.SshConnectionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SSH connections" Height="520" Width="520" MinHeight="420" MinWidth="440"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="🔐 SSH connections" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"
                       Text="Saved connections appear on every terminal's SSH button. AgentHub only stores the address: passwords and keys are handled by ssh itself." />
        </StackPanel>

        <!-- Add form -->
        <Border Grid.Row="1" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
            <StackPanel>
                <TextBlock Text="Name (optional)" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                <TextBox x:Name="NameBox" Margin="0,4,0,10" VerticalContentAlignment="Center" KeyDown="Input_KeyDown" />
                <TextBlock Text="Connect to" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                <DockPanel Margin="0,4,0,0">
                    <Button DockPanel.Dock="Right" Click="Add_Click" Content="➕ Add" Background="#2563eb" FontWeight="SemiBold" Margin="8,0,0,0" Padding="14,7" />
                    <TextBox x:Name="TargetBox" VerticalContentAlignment="Center" KeyDown="Input_KeyDown" />
                </DockPanel>
                <TextBlock Text="user@host  or  user@host:port" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0" />
                <TextBlock x:Name="ErrorText" Foreground="#F87171" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <!-- Saved connections -->
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock DockPanel.Dock="Top" Text="Saved" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" Margin="0,0,0,6" />
            <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" Text="No SSH connections yet." Foreground="{StaticResource MutedBrush}" FontSize="12" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ConnectionList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,6">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Click="Remove_Click" Tag="{Binding}" Content="✕" ToolTip="Remove this connection" Background="#16202F" Foreground="#7E8CA6" Padding="7,3" Margin="0" FontSize="11" FontWeight="Bold" />
                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextBrush}" />
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>

        <!-- Footer -->
        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Click="Close_Click" Content="Done" Margin="8,0,0,0" />
            <TextBlock />
        </DockPanel>
    </Grid>
</Window>
