<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AgentHub</AssemblyName>
    <RootNamespace>AgentHub</RootNamespace>
    <ApplicationIcon>Assets\AgentHub.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Packed into the assembly so the window/taskbar icon resolves at runtime -->
    <Resource Include="Assets\AppIcon.png" />
    <Resource Include="Assets\HeaderLogo.png" />
    <Resource Include="Assets\AgentHub.ico" />
    <!-- Crab mascot sprite strips, 80x80 cells (Controls/CrabMascot) -->
    <Resource Include="Assets\Crab\*.png" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Terminal\Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Built-in orchestrator workflow templates (read-only in the app; Daniel copies one to make his own). -->
    <None Include="..\..\workflows\*.md" Link="workflows\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentHub.Hosting\AgentHub.Hosting.csproj" />
    <!-- The session host ships beside AgentHub.exe: its exe, dll, runtimeconfig and deps come along with the reference. -->
    <ProjectReference Include="..\AgentHub.SessionHost\AgentHub.SessionHost.csproj" />
  </ItemGroup>
</Project>
