<Window x:Class="AgentHub.GitHubLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in to GitHub" Height="500" Width="560" MinHeight="460" MinWidth="500"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="🐙 Sign in to GitHub" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"
                       Text="AgentHub starts the GitHub CLI's browser sign-in for you. You approve the one-time code on github.com and the CLI keeps the token. Nothing is stored in AgentHub, and any account already signed in stays available." />
        </StackPanel>

        <!-- Step 1: choose host -->
        <Border Grid.Row="1" x:Name="HostPanel" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14">
            <StackPanel>
                <TextBlock Text="GitHub host" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="Leave as github.com unless you use GitHub Enterprise Server." Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,8" />
                <DockPanel>
                    <Button x:Name="StartButton" DockPanel.Dock="Right" Click="Start_Click" Content="⚡ Start sign-in" Background="#2563eb" FontWeight="SemiBold" Margin="8,0,0,0" Padding="14,7" />
                    <TextBox x:Name="HostBox" Text="github.com" VerticalContentAlignment="Center" KeyDown="HostBox_KeyDown" />
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Step 2: device code -->
        <Border Grid.Row="2" x:Name="CodePanel" Visibility="Collapsed" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="20,18" MinHeight="230">
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="CodeCaption" Text="Waiting for GitHub CLI to issue a one-time code…" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
                <Border x:Name="CodeBadge" Visibility="Collapsed" Background="#181B20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="24,12" Margin="0,14,0,16" HorizontalAlignment="Center">
                    <TextBlock x:Name="CodeBox" Text="" FontFamily="Consolas" FontSize="36" FontWeight="Bold" TextAlignment="Center"
                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                </Border>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="CopyButton" Click="Copy_Click" Content="📋 Copy code" IsEnabled="False" Margin="0,0,8,0" />
                    <Button x:Name="OpenBrowserButton" Click="OpenBrowser_Click" Content="🌐 Open GitHub in browser" Background="#2563eb" FontWeight="SemiBold" IsEnabled="False" Margin="0" />
                </StackPanel>
                <TextBlock x:Name="UrlText" Text="" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" />
            </StackPanel>
        </Border>

        <!-- Footer -->
        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <Button x:Name="CancelButton" DockPanel.Dock="Right" Click="Cancel_Click" Content="Cancel" Margin="8,0,0,0" />
            <TextBlock x:Name="StatusText" Text="" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" />
        </DockPanel>
    </Grid>
</Window>
