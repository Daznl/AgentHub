<UserControl x:Class="AgentHub.Controls.AppHelperPane"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- Request box: the app-wide TextBox template centres its text vertically, which suits one-line boxes only -->
        <Style x:Key="AskBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#0A111B" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Frame" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="10,8,4,8" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#5A3320" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Small header buttons, as on a terminal pane -->
        <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <!-- Same frame as a terminal pane, so it reads as one more pane on the right -->
    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#0E1622" BorderBrush="#1E2C40" BorderThickness="0,0,0,1" Padding="10,8,8,8">
                <DockPanel LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="NewChatBtn" Style="{StaticResource HeaderButton}" Click="NewChat_Click" Content="New chat" IsEnabled="False"
                                ToolTip="Forget this conversation and start again" />
                        <Button Style="{StaticResource HeaderButton}" Click="Close_Click" Content="✕" ToolTip="Close the helper" AutomationProperties.Name="Close helper" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="AgentHub helper" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="Ask how to do anything in AgentHub" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,1,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <ScrollViewer x:Name="Scroll" Grid.Row="1" Padding="12,12,12,4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Shown until the first question -->
                    <StackPanel x:Name="Examples">
                        <TextBlock Foreground="#B6C2D6" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="I know how every part of AgentHub works: panes, repositories, context files, history, orchestration and settings. Ask me how to do something, or what something on screen means." />
                        <TextBlock Text="For example" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <Button Style="{StaticResource ExampleChip}" Click="Ask_FromChip" Content="How do I start Claude Code in one of my repositories?" />
                        <Button Style="{StaticResource ExampleChip}" Click="Ask_FromChip" Content="What does the context badge on a pane mean?" />
                        <Button Style="{StaticResource ExampleChip}" Click="Ask_FromChip" Content="How do I let an orchestration build while I'm away?" />
                        <Button Style="{StaticResource ExampleChip}" Click="Ask_FromChip" Content="How do I add a rule to my CLAUDE.md?" />
                    </StackPanel>
                    <ItemsControl x:Name="Log" ItemTemplate="{StaticResource HelperMessageTemplate}" />
                    <!-- Follow-up questions offered after the latest answer; a click asks it -->
                    <ItemsControl x:Name="FollowUps" Margin="28,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ExampleChip}" Click="Ask_FromChip" Content="{Binding}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Margin="12,6,12,12">
                <Grid>
                    <TextBox x:Name="Input" Style="{StaticResource AskBox}" MinHeight="58" MaxHeight="150"
                             PreviewKeyDown="Input_PreviewKeyDown" TextChanged="Input_TextChanged" AutomationProperties.Name="Question" />
                    <TextBlock x:Name="InputHint" IsHitTestVisible="False" Margin="14,9,14,0" Foreground="#4A5A73" FontSize="13"
                               TextWrapping="Wrap" VerticalAlignment="Top" Text="Ask about AgentHub…" />
                </Grid>
                <DockPanel Margin="0,8,0,0" LastChildFill="True">
                    <Button x:Name="AskBtn" DockPanel.Dock="Right" Click="AskBtn_Click" Content="Ask" Margin="0" Padding="18,6" FontSize="12" FontWeight="SemiBold"
                            Background="#9A3F17" IsEnabled="False"
                            ToolTip="Ask the helper (Enter). Uses your Claude login through Claude Code; it reads AgentHub's own documentation and never changes anything." />
                    <TextBlock x:Name="Hint" Text="Enter asks · Shift+Enter new line" Foreground="{StaticResource MutedBrush}" FontSize="11"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                </DockPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
