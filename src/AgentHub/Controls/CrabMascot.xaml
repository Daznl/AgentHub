<UserControl x:Class="AgentHub.Controls.CrabMascot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AgentHub.Controls"
             Focusable="False">
    <!-- The canvas sizes to nothing, so the crab never moves the header layout; frames may poke above it while hopping -->
    <Canvas x:Name="Stage" ClipToBounds="False" UseLayoutRounding="True">
        <!-- Focusable so Tab reaches it like the button it is; its glow is the focus cue, so no dashed rectangle -->
        <local:CrabSprite x:Name="Sprite" Stretch="Fill" Cursor="Hand" SnapsToDevicePixels="True" Focusable="True" FocusVisualStyle="{x:Null}"
               RenderOptions.BitmapScalingMode="NearestNeighbor" RenderOptions.EdgeMode="Aliased"
               AutomationProperties.Name="AgentHub helper" MouseLeftButtonUp="Sprite_MouseLeftButtonUp" KeyDown="Sprite_KeyDown" />
    </Canvas>
</UserControl>
