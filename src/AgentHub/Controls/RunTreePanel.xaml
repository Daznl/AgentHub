<UserControl x:Class="AgentHub.Controls.RunTreePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="236" AutomationProperties.AutomationId="RunTreePanel" AutomationProperties.Name="Run tree">
    <UserControl.Resources>
        <!-- A row of the tree: the whole row takes the click (and Enter or Space), with no chrome of its own; the card inside shows hover and focus. -->
        <Style x:Key="RowButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Stretch" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- ✕ in the corner: flat, lit under the pointer. -->
        <Style x:Key="CloseButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#9A8FC7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="4" Padding="5,1,5,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2E2357" />
                                <Setter Property="Foreground" Value="#EDE9FE" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2E2357" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <!-- In the orchestrator's purple, like its box above the pane: the tree belongs to the orchestrator. -->
    <Border Background="#151129" BorderBrush="#4C3A8C" BorderThickness="1" CornerRadius="8" Padding="8,6,2,6">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" LastChildFill="True" Margin="0,0,6,6">
                <Button x:Name="CloseBtn" DockPanel.Dock="Right" Click="Close_Click" Content="✕" ToolTip="Hide the run tree (◨ Tree above the session shows it again)"
                        AutomationProperties.Name="Hide the run tree" Style="{StaticResource CloseButton}" FontSize="10" VerticalAlignment="Top" />
                <StackPanel>
                    <TextBlock Text="RUN TREE" Foreground="#A78BFA" FontSize="10" FontWeight="Bold" />
                    <TextBlock x:Name="SummaryText" Foreground="#9A8FC7" FontSize="10" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0" Focusable="False">
                <StackPanel x:Name="RowsPanel" Margin="0,0,0,4" />
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
