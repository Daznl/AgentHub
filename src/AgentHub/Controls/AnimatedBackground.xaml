<UserControl x:Class="AgentHub.Controls.AnimatedBackground"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False" Focusable="False" ClipToBounds="True">
    <!--
        Living "deep space" backdrop for the main window.

        Layers, back to front:
          1. Static diagonal gradient (WindowBackgroundBrush) so the window never flashes white.
          2. A faint tiled grid that scrolls diagonally - the "AI cockpit" texture.
          3. Four large radial-gradient glow orbs in the brand accents that drift and breathe.
          4. A soft horizontal scan sweep that travels top to bottom.
          5. A vignette that darkens the edges so the content panels stay the focal point.

        Everything is pure WPF composition: no BlurEffect, no per-frame code. The storyboard runs at
        30 fps (Timeline.DesiredFrameRate) so the GPU cost stays negligible next to the terminals.
        Motion is started from code-behind (see SetAnimated) so it can be switched off in settings.
    -->
    <UserControl.Resources>
        <Storyboard x:Key="DriftStoryboard" Timeline.DesiredFrameRate="30">
            <!-- Cyan orb: wide slow drift plus a gentle breathe -->
            <DoubleAnimation Storyboard.TargetName="OrbCyanMove" Storyboard.TargetProperty="X"
                             From="-60" To="140" Duration="0:0:38" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="OrbCyanMove" Storyboard.TargetProperty="Y"
                             From="-40" To="120" Duration="0:0:27" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="OrbCyanScale" Storyboard.TargetProperty="ScaleX"
                             From="0.9" To="1.15" Duration="0:0:19" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="OrbCyanScale" Storyboard.TargetProperty="ScaleY"
                             From="0.9" To="1.15" Duration="0:0:19" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- Mint orb: opposite corner, counter-drift -->
            <DoubleAnimation Storyboard.TargetName="OrbMintMove" Storyboard.TargetProperty="X"
                             From="80" To="-160" Duration="0:0:43" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="OrbMintMove" Storyboard.TargetProperty="Y"
                             From="60" To="-110" Duration="0:0:31" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="OrbMintScale" Storyboard.TargetProperty="ScaleX"
                             From="1.1" To="0.85" Duration="0:0:23" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="OrbMintScale" Storyboard.TargetProperty="ScaleY"
                             From="1.1" To="0.85" Duration="0:0:23" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- Violet orb: centre depth layer -->
            <DoubleAnimation Storyboard.TargetName="OrbVioletMove" Storyboard.TargetProperty="X"
                             From="-120" To="120" Duration="0:0:53" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="OrbVioletMove" Storyboard.TargetProperty="Y"
                             From="90" To="-90" Duration="0:0:35" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- Orange orb: small, quicker accent that pulses -->
            <DoubleAnimation Storyboard.TargetName="OrbOrangeMove" Storyboard.TargetProperty="X"
                             From="40" To="-90" Duration="0:0:29" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="OrbOrangeMove" Storyboard.TargetProperty="Y"
                             From="-70" To="110" Duration="0:0:21" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="OrbOrange" Storyboard.TargetProperty="Opacity"
                             From="0.45" To="1.0" Duration="0:0:9" AutoReverse="True" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>

            <!-- Grid: translate by exactly one tile period (48px) so the loop is seamless -->
            <DoubleAnimation Storyboard.TargetName="GridShift" Storyboard.TargetProperty="X"
                             From="0" To="48" Duration="0:0:24" RepeatBehavior="Forever" />
            <DoubleAnimation Storyboard.TargetName="GridShift" Storyboard.TargetProperty="Y"
                             From="0" To="48" Duration="0:0:36" RepeatBehavior="Forever" />

            <!-- Scan sweep: the gradient band travels down the window and repeats -->
            <DoubleAnimation Storyboard.TargetName="ScanShift" Storyboard.TargetProperty="Y"
                             From="-0.7" To="0.7" Duration="0:0:14" BeginTime="0:0:2" RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut" /></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Grid>
        <!-- 1. Base gradient -->
        <Rectangle Fill="{StaticResource WindowBackgroundBrush}" />

        <!-- 2. Scrolling grid texture -->
        <Rectangle Opacity="0.55">
            <Rectangle.Fill>
                <DrawingBrush TileMode="Tile" Viewport="0,0,48,48" ViewportUnits="Absolute" Stretch="None">
                    <DrawingBrush.Transform>
                        <TranslateTransform x:Name="GridShift" />
                    </DrawingBrush.Transform>
                    <DrawingBrush.Drawing>
                        <DrawingGroup>
                            <GeometryDrawing>
                                <GeometryDrawing.Pen>
                                    <Pen Brush="#1A2A40" Thickness="1" />
                                </GeometryDrawing.Pen>
                                <GeometryDrawing.Geometry>
                                    <GeometryGroup>
                                        <LineGeometry StartPoint="0,0.5" EndPoint="48,0.5" />
                                        <LineGeometry StartPoint="0.5,0" EndPoint="0.5,48" />
                                    </GeometryGroup>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                            <!-- node dot at each intersection -->
                            <GeometryDrawing Brush="#2A3D5A">
                                <GeometryDrawing.Geometry>
                                    <EllipseGeometry Center="0.5,0.5" RadiusX="1.2" RadiusY="1.2" />
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingGroup>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- 3. Glow orbs. Alignment + negative margins anchor them to corners at any window size. -->
        <Ellipse x:Name="OrbCyan" Width="900" Height="900" HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="-380,-420,0,0" RenderTransformOrigin="0.5,0.5">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#5A2FD4F5" Offset="0" />
                    <GradientStop Color="#222FD4F5" Offset="0.45" />
                    <GradientStop Color="#002FD4F5" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="OrbCyanScale" />
                    <TranslateTransform x:Name="OrbCyanMove" />
                </TransformGroup>
            </Ellipse.RenderTransform>
        </Ellipse>

        <Ellipse x:Name="OrbMint" Width="820" Height="820" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="0,0,-360,-400" RenderTransformOrigin="0.5,0.5">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#4A34E5A8" Offset="0" />
                    <GradientStop Color="#1A34E5A8" Offset="0.45" />
                    <GradientStop Color="#0034E5A8" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="OrbMintScale" />
                    <TranslateTransform x:Name="OrbMintMove" />
                </TransformGroup>
            </Ellipse.RenderTransform>
        </Ellipse>

        <Ellipse x:Name="OrbViolet" Width="1000" Height="700" HorizontalAlignment="Center" VerticalAlignment="Center"
                 Margin="0,120,0,0" RenderTransformOrigin="0.5,0.5">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#387C3AED" Offset="0" />
                    <GradientStop Color="#127C3AED" Offset="0.5" />
                    <GradientStop Color="#007C3AED" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform>
                <TranslateTransform x:Name="OrbVioletMove" />
            </Ellipse.RenderTransform>
        </Ellipse>

        <Ellipse x:Name="OrbOrange" Width="420" Height="420" HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-120,120,0" RenderTransformOrigin="0.5,0.5">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#40FF7A45" Offset="0" />
                    <GradientStop Color="#12FF7A45" Offset="0.5" />
                    <GradientStop Color="#00FF7A45" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.RenderTransform>
                <TranslateTransform x:Name="OrbOrangeMove" />
            </Ellipse.RenderTransform>
        </Ellipse>

        <!-- 4. Scan sweep -->
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <LinearGradientBrush.RelativeTransform>
                        <TranslateTransform x:Name="ScanShift" Y="-0.7" />
                    </LinearGradientBrush.RelativeTransform>
                    <GradientStop Color="#002FD4F5" Offset="0.40" />
                    <GradientStop Color="#142FD4F5" Offset="0.49" />
                    <GradientStop Color="#1E9FE8FF" Offset="0.50" />
                    <GradientStop Color="#142FD4F5" Offset="0.51" />
                    <GradientStop Color="#002FD4F5" Offset="0.60" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- 5. Vignette -->
        <Rectangle>
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,0.45" GradientOrigin="0.5,0.45" RadiusX="0.85" RadiusY="0.9">
                    <GradientStop Color="#00000000" Offset="0.55" />
                    <GradientStop Color="#66000000" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
    </Grid>
</UserControl>
