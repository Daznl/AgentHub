<Window x:Class="AgentHub.ContextWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AgentHub.Controls"
        Title="AgentHub - Context" Height="680" Width="820" MinHeight="380" MinWidth="560"
        Icon="Assets/AppIcon.png" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI">
    <Window.Resources>
        <!-- File tabs: lit when that file is the one being edited -->
        <Style x:Key="FileTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Background" Value="#141D2B" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="GroupName" Value="ContextFiles" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chip" CornerRadius="14" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="#12324A" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Full-height editor: the app-wide TextBox template centres its content vertically, which suits one-line boxes only -->
        <Style x:Key="Editor" TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#0A111B" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="AcceptsTab" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Frame" CornerRadius="6" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="10,8,4,8" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="#24506B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Review "Apply" box in the app's dark style (WPF's default is a bright white square) -->
        <Style TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="4" Background="#0A111B" BorderBrush="#3A4B66" BorderThickness="1" VerticalAlignment="Center">
                                <Path x:Name="Tick" Data="M 3.5,8 L 6.5,11 L 12.5,4.5" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#0E7490" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#0E7490" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="ApplicationCommands.Save" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Save" Executed="SaveCommand_Executed" />
    </Window.CommandBindings>

    <Grid>
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <Grid Grid.Column="0" Margin="16,14,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
            <!-- The crab, and the button that opens the Context helper: rests at the top right and roams the strip beside the heading -->
            <controls:CrabMascot x:Name="Crab" DockPanel.Dock="Right" Width="150" Height="56" VerticalAlignment="Top" Margin="12,0,0,0"
                                 HelperName="Context helper"
                                 ToolTip="Context helper: say what to add or change in this file. Claude Code suggests the edits and you choose which go in." />
            <StackPanel>
                <TextBlock x:Name="HeadingText" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="SubheadingText" Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DockPanel>

        <WrapPanel x:Name="TabsPanel" Grid.Row="1" Margin="0,0,0,4" />

        <!-- Which file the editor holds, and whether it exists yet -->
        <DockPanel Grid.Row="2" Margin="2,0,0,8" LastChildFill="True">
            <Border x:Name="FileStateBadge" DockPanel.Dock="Left" CornerRadius="4" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Center">
                <TextBlock x:Name="FileStateText" FontSize="10" FontWeight="Bold" />
            </Border>
            <TextBlock x:Name="FilePathText" Foreground="{StaticResource MutedBrush}" FontSize="11" FontFamily="Cascadia Mono, Consolas"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <Grid Grid.Row="3">
            <TextBox x:Name="Editor" Style="{StaticResource Editor}" TextChanged="Editor_TextChanged" />
            <!-- Hint over an empty editor; never takes clicks, so typing starts straight away -->
            <TextBlock x:Name="EmptyHint" IsHitTestVisible="False" Margin="14,10,14,0" Foreground="#4A5A73" FontSize="13"
                       FontFamily="Cascadia Mono, Consolas" TextWrapping="Wrap" VerticalAlignment="Top" />

            <!-- Review result in place of the editor: what changed and why, then each change with its own Apply box -->
            <Border x:Name="ReviewPanel" Visibility="Collapsed" Background="#0A111B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="14,12,14,6">
                        <TextBlock x:Name="ReviewHeading" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock x:Name="ReviewSummary" Foreground="#B6C2D6" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock x:Name="ReviewUnplaced" Foreground="#FCD34D" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed" />
                        <Border Height="10" />
                        <ItemsControl x:Name="HunkList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#0E1622" BorderBrush="#1E2C40" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding Accepted, Mode=TwoWay}" Click="HunkToggle_Click" Content="Apply"
                                                          Foreground="{StaticResource TextBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                                          AutomationProperties.Name="{Binding Title}" />
                                                <TextBlock Text="{Binding Title}" Foreground="#7E8CA6" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Why}" Visibility="{Binding WhyVisibility}" Foreground="#B6C2D6" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6" />
                                            <TextBlock Text="{Binding RemovedText}" Visibility="{Binding RemovedVisibility}" Background="#2A1218" Foreground="#FCA5A5"
                                                       FontFamily="Cascadia Mono, Consolas" FontSize="12" Padding="8,4" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding AddedText}" Visibility="{Binding AddedVisibility}" Background="#0C2A1F" Foreground="#86EFAC"
                                                       FontFamily="Cascadia Mono, Consolas" FontSize="12" Padding="8,4" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <DockPanel Grid.Row="4" Margin="0,12,0,0" LastChildFill="True">
            <StackPanel x:Name="EditButtons" DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="ReviewBtn" Click="Review_Click" Content="✨ Review" Margin="0,0,8,0" Padding="12,6" FontSize="12" FontWeight="SemiBold" Background="#3B2A63"
                        ToolTip="Ask Claude Code to suggest improvements to this file, including unsaved edits. Uses your Claude login, no API key; it only reads the text and never edits files. You choose which changes to apply." />
                <Button x:Name="OpenFolderBtn" Click="OpenFolder_Click" Content="Open folder" Margin="0,0,8,0" Padding="12,6" FontSize="12" ToolTip="Show this file's folder in File Explorer" />
                <Button x:Name="ReloadBtn" Click="Reload_Click" Content="↻ Reload" Margin="0,0,8,0" Padding="12,6" FontSize="12" ToolTip="Discard unsaved edits and read the file again" />
                <Button x:Name="SaveBtn" Click="Save_Click" Content="Save" Margin="0" Padding="18,6" FontSize="12" FontWeight="SemiBold" Background="#0E7490"
                        ToolTip="Write your edits to the file (Ctrl+S). Every new session of the CLI reads it." />
            </StackPanel>
            <StackPanel x:Name="ReviewButtons" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Collapsed">
                <Button Click="DiscardReview_Click" Content="Discard review" Margin="0,0,8,0" Padding="12,6" FontSize="12" ToolTip="Close the review and leave the editor as it was" />
                <Button x:Name="ApplyReviewBtn" Click="ApplyReview_Click" Margin="0" Padding="18,6" FontSize="12" FontWeight="SemiBold" Background="#0E7490"
                        ToolTip="Put the ticked changes into the editor. Nothing is written to the file until you Save." />
            </StackPanel>
            <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="2,0,12,0" />
        </DockPanel>
    </Grid>

    <!-- Context helper: ask in plain words for something to add; the suggested edits appear on the left with Apply boxes -->
    <Border x:Name="HelperPanel" Grid.Column="1" Width="330" Visibility="Collapsed" Background="#0B121D"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
        <Grid Margin="14,14,14,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="True">
                <Button DockPanel.Dock="Right" Click="CloseHelper_Click" Content="✕" Margin="0" Padding="8,3" FontSize="11" VerticalAlignment="Top"
                        Background="Transparent" BorderBrush="Transparent" ToolTip="Close the helper" AutomationProperties.Name="Close helper" />
                <Image DockPanel.Dock="Left" Source="{StaticResource CrabIcon}" Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Top" />
                <StackPanel>
                    <TextBlock Text="Context helper" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="HelperTarget" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,2,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </DockPanel>

            <ScrollViewer x:Name="HelperScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Shown until the first request -->
                    <StackPanel x:Name="HelperExamples">
                        <TextBlock Foreground="#B6C2D6" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"
                                   Text="Say what you want the agent to know or do, in your own words. Claude Code turns it into rules, puts them in the right section, and shows them on the left. You tick which to keep, then Save." />
                        <TextBlock Text="For example" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <Button Style="{StaticResource ExampleChip}" Click="Example_Click" Content="Always run the tests before committing, and fix any that fail" />
                        <Button Style="{StaticResource ExampleChip}" Click="Example_Click" Content="Ask me before deleting files or force-pushing" />
                        <Button Style="{StaticResource ExampleChip}" Click="Example_Click" Content="Use Australian spelling in docs and commit messages" />
                    </StackPanel>
                    <ItemsControl x:Name="HelperLog" ItemTemplate="{StaticResource HelperMessageTemplate}" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <Grid>
                    <TextBox x:Name="HelperInput" Style="{StaticResource Editor}" FontFamily="Segoe UI" MinHeight="64" MaxHeight="160"
                             AcceptsTab="False" PreviewKeyDown="HelperInput_PreviewKeyDown" TextChanged="HelperInput_TextChanged"
                             AutomationProperties.Name="Request" />
                    <TextBlock x:Name="HelperInputHint" IsHitTestVisible="False" Margin="14,9,14,0" Foreground="#4A5A73" FontSize="13"
                               TextWrapping="Wrap" VerticalAlignment="Top" Text="What should be added or changed?" />
                </Grid>
                <DockPanel Margin="0,8,0,0" LastChildFill="True">
                    <Button x:Name="HelperSendBtn" DockPanel.Dock="Right" Click="HelperSend_Click" Content="Suggest" Margin="0" Padding="16,6"
                            FontSize="12" FontWeight="SemiBold" Background="#9A3F17" IsEnabled="False"
                            ToolTip="Ask Claude Code for edits that do this (Enter). Uses your Claude login; it only reads this file's text and never edits files." />
                    <TextBlock x:Name="HelperHint" Text="Enter sends · Shift+Enter new line" Foreground="{StaticResource MutedBrush}" FontSize="11"
                               VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,10,0" />
                </DockPanel>
            </StackPanel>
        </Grid>
    </Border>
    </Grid>
</Window>
