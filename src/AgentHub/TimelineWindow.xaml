<Window x:Class="AgentHub.TimelineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AgentHub.Controls"
        Title="AgentHub - Timeline" Height="840" Width="1240" MinHeight="420" MinWidth="820"
        Icon="Assets/AppIcon.png" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI">
    <Window.Resources>
        <!-- Small action inside a card -->
        <Style x:Key="CardButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#16202F" />
            <Setter Property="Foreground" Value="#B6C2D6" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <!-- One of the crab's two reviews in the helper pane: a name and what it looks at; the name reads "■ Cancel" while it runs -->
        <Style x:Key="ReviewAction" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chip" CornerRadius="8" Background="#2A1F47" BorderBrush="#3B2A63" BorderThickness="1" Padding="12,9">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource CrabBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chip" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16,14,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="RefreshBtn" Click="Refresh_Click" Content="↻ Refresh" ToolTip="Read the commits and transcripts again now (they are re-read every 20 seconds while this window is open)"
                        Padding="10,5" Margin="0,0,8,0" FontSize="12" />
                <Button x:Name="WorldBtn" Click="World_Click" Content="🌐 3D" Padding="10,5" Margin="0,0,8,0" FontSize="12"
                        ToolTip="Open the 3D world (experimental, Godot): this repository and every other project, files as a city, branches as a tree, a crab for each running session" />
                <Button Click="Close_Click" Content="✕ Close" ToolTip="Close the timeline (Esc does too)" Padding="10,5" Margin="0" FontSize="12" />
            </StackPanel>
            <!-- The crab, and the button that opens the Timeline helper (the two reviews, and questions about the timeline):
                 rests beside Refresh and roams the strip towards the heading; paces while a review runs -->
            <controls:CrabMascot x:Name="Crab" DockPanel.Dock="Right" Width="150" Height="56" VerticalAlignment="Top" Margin="12,0,12,0"
                                 HelperName="Timeline helper"
                                 ToolTip="Timeline helper: ask Claude Code to review how you and Claude worked, or the GitHub cycle, or ask how the timeline works" />
            <StackPanel Margin="0,0,12,0">
                <TextBlock x:Name="HeadingText" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SubheadingText" Margin="0,3,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

        <!-- The Timeline helper: the crab's two reviews, then a conversation about how the timeline works. Rightmost, so the
             reports it produces sit between it and the tree. -->
        <controls:AppHelperPane x:Name="Helper" Grid.Column="2" Width="400" Margin="12,0,0,0" Visibility="Collapsed"
                                Title="Timeline helper" Subtitle="Two reviews, and how this timeline works"
                                Placeholder="Ask about the timeline…"
                                Intro="I can explain this timeline: the tree, the lanes, the session and commit cards, and what the two reviews above look at. Ask me how to read something, or what to do next." />
        <!-- Its Actions (the two review buttons, style ReviewAction) are built in BuildReviewActions: WPF allows no x:Name inside another control's content -->

        <!-- The two review reports sit beside the tree, one above the other, not over it, so their evidence (session ids, hashes) can be matched to the cards -->
        <Grid x:Name="ReportsColumn" Grid.Column="1" Width="460" Margin="12,0,0,0" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border x:Name="SessionsReportPanel" Grid.Row="0" Visibility="Collapsed" Margin="0,0,0,6" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10,6,10">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,6,8" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Tag="sessions" Click="CloseReport_Click" Content="✕" Padding="7,1" FontSize="11" VerticalAlignment="Top" ToolTip="Close the report (it stays saved on disk)" />
                        <StackPanel>
                            <TextBlock Text="REVIEW · YOU AND CLAUDE" Foreground="#5A6B85" FontSize="10" FontWeight="Bold" />
                            <TextBlock x:Name="SessionsReportMeta" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="SessionsAddRulesBtn" Tag="sessions" Click="AddRules_Click" Content="Add to CLAUDE.md…" Background="#0E7490" FontWeight="SemiBold" Padding="10,4" FontSize="11" Margin="0,0,8,0"
                                ToolTip="Open your user-wide CLAUDE.md in the Context editor with the suggested rules as changes you can tick and apply. Nothing is saved until you press Save there." />
                        <Button Tag="sessions" Click="OpenReport_Click" Content="Open report" Padding="10,4" FontSize="11" Margin="0,0,8,0" ToolTip="Open the saved Markdown report" />
                        <Button Tag="sessions" Click="OpenDigest_Click" Content="What was sent" Padding="10,4" FontSize="11" ToolTip="Open the digest that was sent to Claude Code, exactly as sent" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                        <StackPanel x:Name="SessionsReportBody" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <Border x:Name="GitHubReportPanel" Grid.Row="1" Visibility="Collapsed" Margin="0,6,0,0" Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10,6,10">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,6,8" LastChildFill="True">
                        <Button DockPanel.Dock="Right" Tag="github" Click="CloseReport_Click" Content="✕" Padding="7,1" FontSize="11" VerticalAlignment="Top" ToolTip="Close the report (it stays saved on disk)" />
                        <StackPanel>
                            <TextBlock Text="REVIEW · GITHUB CYCLE" Foreground="#5A6B85" FontSize="10" FontWeight="Bold" />
                            <TextBlock x:Name="GitHubReportMeta" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
                        <Button x:Name="GitHubAddRulesBtn" Tag="github" Click="AddRules_Click" Content="Add to CLAUDE.md…" Background="#0E7490" FontWeight="SemiBold" Padding="10,4" FontSize="11" Margin="0,0,8,0"
                                ToolTip="Open your user-wide CLAUDE.md in the Context editor with the suggested rules as changes you can tick and apply. Nothing is saved until you press Save there." />
                        <Button Tag="github" Click="OpenReport_Click" Content="Open report" Padding="10,4" FontSize="11" Margin="0,0,8,0" ToolTip="Open the saved Markdown report" />
                        <Button Tag="github" Click="OpenDigest_Click" Content="What was sent" Padding="10,4" FontSize="11" ToolTip="Open the digest that was sent to Claude Code, exactly as sent" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                        <StackPanel x:Name="GitHubReportBody" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8,10,4,4">
            <DockPanel>
                <!-- Column headings, laid out like a row: tree, then sessions, then commits -->
                <Grid x:Name="HeaderRow" DockPanel.Dock="Top" Margin="0,0,8,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>
                    <Border x:Name="HeaderGutter" Grid.Column="0" Width="22" />
                    <TextBlock Grid.Column="1" Text="SESSIONS · WHAT HAPPENED" Foreground="#5A6B85" FontSize="10" FontWeight="Bold" Margin="18,0,0,0" />
                    <TextBlock Grid.Column="2" Text="COMMITS · WHAT LANDED IN GIT" Foreground="#5A6B85" FontSize="10" FontWeight="Bold" Margin="22,0,0,0" />
                </Grid>
                <Grid>
                <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                    <StackPanel x:Name="RowsPanel" />
                </ScrollViewer>
                <TextBlock x:Name="EmptyText" Visibility="Collapsed" Foreground="{StaticResource MutedBrush}" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="460" />
                </Grid>
            </DockPanel>
        </Border>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="2,10,0,0" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
    </Grid>
</Window>
