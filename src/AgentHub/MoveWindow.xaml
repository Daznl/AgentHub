<Window x:Class="AgentHub.MoveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AgentHub - Move to another computer" Height="760" Width="780" MinHeight="520" MinWidth="620"
        Icon="Assets/AppIcon.png" WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBackgroundBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI">
    <Window.Resources>
        <!-- Tick box in the app's dark style (WPF's default is a bright white square); same as the to-do list's -->
        <Style TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="4" Background="#0A111B" BorderBrush="#3A4B66" BorderThickness="1" VerticalAlignment="Center">
                            <Path x:Name="Tick" Data="M 4,9 L 7.5,12.5 L 14,5" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" Visibility="Collapsed" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#0E7490" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="#0E7490" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="3" Background="#1A2434" />
                            <Border x:Name="PART_Indicator" CornerRadius="3" Background="{StaticResource AccentBrush}" HorizontalAlignment="Left" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ModeButton" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="#B6C2D6" />
            <Setter Property="Background" Value="#141D2B" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root" CornerRadius="6" Padding="16,8" Background="{TemplateBinding Background}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#0E7490" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#0E7490" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#7E8CA6" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#0A111B" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </Window.Resources>

    <Grid Margin="18,14,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Move to another computer" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"
                       Text="Pack AgentHub's settings, your past sessions and your Claude Code and Codex setup into one zip. Send it to yourself (OneDrive or Teams), then unpack it in AgentHub on the other computer. Sign-ins never move: sign in again there." />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,4">
            <ToggleButton x:Name="PackModeBtn" Style="{StaticResource ModeButton}" Content="📦 Pack this computer" Click="PackMode_Click" Margin="0,0,8,0"
                          AutomationProperties.Name="Pack this computer" />
            <ToggleButton x:Name="UnpackModeBtn" Style="{StaticResource ModeButton}" Content="📥 Unpack a package" Click="UnpackMode_Click"
                          AutomationProperties.Name="Unpack a package" />
        </StackPanel>

        <!-- ================= Pack ================= -->
        <Grid x:Name="PackPanel" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0">
                <TextBlock x:Name="PackTotalText" DockPanel.Dock="Right" Style="{StaticResource SectionTitle}" Foreground="{StaticResource TextBrush}" />
                <TextBlock Style="{StaticResource SectionTitle}" Text="WHAT GOES IN THE ZIP" />
            </DockPanel>
            <Border Grid.Row="1" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="PackItems" Margin="6" />
                </ScrollViewer>
            </Border>

            <StackPanel Grid.Row="2">
                <TextBlock Style="{StaticResource SectionTitle}" Text="SAVE THE ZIP AS" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Browse…" Click="PackBrowse_Click" Margin="8,0,0,0" Padding="14,6" ToolTip="Choose where the zip is saved, for example a OneDrive folder" />
                    <TextBox x:Name="PackPathBox" FontFamily="Cascadia Mono, Consolas" FontSize="12" Padding="8,6" VerticalContentAlignment="Center"
                             AutomationProperties.Name="Save the zip as" />
                </DockPanel>
                <Border Margin="0,10,0,0" Background="#1F1A10" BorderBrush="#5C4A1F" BorderThickness="1" CornerRadius="6" Padding="10,7">
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#E9D7A8"
                               Text="Keep this zip private. Session transcripts hold every prompt and reply and the output of every command and file read, which can include passwords, keys and company data. Send it only to yourself." />
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                <ProgressBar x:Name="PackProgress" Minimum="0" Maximum="1" Visibility="Collapsed" Margin="0,0,0,6" />
                <TextBlock x:Name="PackStatus" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="PackShowBtn" Content="Show in folder" Click="PackShow_Click" Visibility="Collapsed" Margin="0,0,8,0" Padding="14,6" />
                <Button x:Name="PackCancelBtn" Content="Cancel" Click="Cancel_Click" Visibility="Collapsed" Margin="0,0,8,0" Padding="14,6" />
                <Button x:Name="PackBtn" Content="📦 Pack" Click="Pack_Click" Margin="0" Padding="20,6" FontWeight="SemiBold" Background="#0E7490" />
            </StackPanel>
        </Grid>

        <!-- ================= Unpack ================= -->
        <Grid x:Name="UnpackPanel" Grid.Row="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Style="{StaticResource SectionTitle}" Text="PACKAGE" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Browse…" Click="UnpackBrowse_Click" Margin="8,0,0,0" Padding="14,6" ToolTip="Choose the zip packed on the other computer" />
                    <TextBox x:Name="UnpackPathBox" FontFamily="Cascadia Mono, Consolas" FontSize="12" Padding="8,6" VerticalContentAlignment="Center" IsReadOnly="True"
                             AutomationProperties.Name="Package" />
                </DockPanel>
                <TextBlock x:Name="UnpackFromText" Margin="2,8,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                           Text="Choose the AgentHub-move-….zip packed on the other computer." />
            </StackPanel>

            <ScrollViewer Grid.Row="1" Margin="0,4,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <StackPanel x:Name="UnpackChoices" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="WHAT TO UNPACK" />
                        <Border Style="{StaticResource Card}">
                            <StackPanel x:Name="UnpackItems" Margin="6" />
                        </Border>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="FOLDERS ON THIS COMPUTER" />
                        <TextBlock x:Name="MappingsHint" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="2,0,0,6" />
                        <StackPanel x:Name="MappingRows" />
                        <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="2,6,0,0"
                                   Text="Nothing is overwritten. Files this computer already has are kept; where they differ, the imported copy is set aside and listed after unpacking." />
                    </StackPanel>

                    <StackPanel x:Name="UnpackResults" Visibility="Collapsed">
                        <Border x:Name="RestartBanner" Margin="0,14,0,0" Background="#0F2A26" BorderBrush="#1F6F5C" BorderThickness="1" CornerRadius="6" Padding="12,9" Visibility="Collapsed">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="↻ Restart AgentHub" Click="Restart_Click" Margin="10,0,0,0" Padding="14,6" FontWeight="SemiBold" Background="#0E7490"
                                        ToolTip="Close and reopen AgentHub. Running sessions keep running." />
                                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12" Foreground="#BDEBDD"
                                           Text="Restart AgentHub to finish: its settings (repositories, panes) are merged when it starts. Running sessions keep running." />
                            </DockPanel>
                        </Border>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="RESULT" />
                        <TextBlock x:Name="ResultSummary" FontSize="12" TextWrapping="Wrap" Margin="2,0,0,0" />
                        <StackPanel x:Name="ConflictSection" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="DIFFERENT ON THIS COMPUTER: THIS COMPUTER'S COPY KEPT" />
                            <Border Style="{StaticResource Card}">
                                <StackPanel x:Name="ConflictRows" Margin="6" />
                            </Border>
                        </StackPanel>
                        <StackPanel x:Name="RepoSection" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="REPOSITORIES NOT ON THIS COMPUTER YET" />
                            <Border Style="{StaticResource Card}">
                                <StackPanel x:Name="RepoRows" Margin="6" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="McpText" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="2,12,0,0" Visibility="Collapsed" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                <ProgressBar x:Name="UnpackProgress" Minimum="0" Maximum="1" Visibility="Collapsed" Margin="0,0,0,6" />
                <TextBlock x:Name="UnpackStatus" Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="ReportBtn" Content="Open report" Click="Report_Click" Visibility="Collapsed" Margin="0,0,8,0" Padding="14,6" />
                <Button x:Name="UnpackCancelBtn" Content="Cancel" Click="Cancel_Click" Visibility="Collapsed" Margin="0,0,8,0" Padding="14,6" />
                <Button x:Name="UnpackBtn" Content="📥 Unpack" Click="Unpack_Click" IsEnabled="False" Margin="0" Padding="20,6" FontWeight="SemiBold" Background="#0E7490" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
